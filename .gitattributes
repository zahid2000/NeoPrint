# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Files that MUST be LF in the working tree as well: they are executed inside
# Linux containers or on the Linux kiosk, where CRLF breaks the shebang.
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.env.*          text eol=lf
*.hcl           text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.rules         text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows-only scripts keep CRLF.
*.ps1           text eol=crlf
*.psm1          text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Binary — never touch.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.so            binary
*.dll           binary
*.dylib         binary
*.jks           binary
*.keystore      binary

# Keep the specification out of language statistics and diffs by default.
docs/NeoPrint-PLAN.md linguist-documentation
