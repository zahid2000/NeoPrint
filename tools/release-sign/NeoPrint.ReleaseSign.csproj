<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The offline release signing tool (docs/RELEASE_SIGNING.md, T-313):
    generates the release key pairs, writes the manifest CI publishes, signs it
    on the owner's offline machine and verifies a package exactly as a kiosk
    does. Uses only the BCL (ECDSA P-256) - no package.

    CI runs only "manifest", "verify" and "check-build"; it never holds a
    private key.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NeoPrint.ReleaseSign</RootNamespace>
    <AssemblyName>release-sign</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\shared\NeoPrint.Crypto\NeoPrint.Crypto.csproj" />
  </ItemGroup>

  <!--
    Both kiosk key sets (T-316): "verify" with a key set answers as a kiosk of that
    set would, "sign" and "sign-staging" refuse a key of the wrong set, and
    "check-build" knows what must not be in a build.
  -->
  <ItemGroup>
    <Compile Include="..\..\desktop\src\NeoPrint.Kiosk.Core\Updates\KeySets\ReleaseKeys.production.cs" Link="KeySets\ReleaseKeys.production.cs" />
    <Compile Include="..\..\desktop\src\NeoPrint.Kiosk.Core\Updates\KeySets\ReleaseKeys.staging.cs" Link="KeySets\ReleaseKeys.staging.cs" />
  </ItemGroup>

</Project>
