<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that talks to the outside world: MongoDB, Redis, RabbitMQ via
    MassTransit, Hangfire, SMTP, the OpenBao secret store and the mock payment
    and fiscal providers.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NeoPrint.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup Label="Data stores">
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup Label="Messaging and jobs">
    <!-- Pinned to 8.x: v9 and later are commercially licensed. -->
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="MassTransit.MongoDb" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.Mongo" />
  </ItemGroup>

  <ItemGroup Label="Providers">
    <PackageReference Include="MailKit" />
    <PackageReference Include="QRCoder" />
    <!-- Receipt PDFs. Community licence: see docs/THIRD_PARTY.md. -->
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup Label="Receipt font">
    <!-- Inter (SIL OFL 1.1), the same file as the mobile app's: docs/THIRD_PARTY.md. -->
    <EmbeddedResource Include="Receipts\Fonts\Inter-Variable.ttf" LogicalName="NeoPrint.Receipts.Inter.ttf" />
    <None Include="Receipts\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\Inter-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoPrint.Application\NeoPrint.Application.csproj" />
    <ProjectReference Include="..\..\shared\NeoPrint.Crypto\NeoPrint.Crypto.csproj" />
  </ItemGroup>

  <!--
    The kiosk's two release key sets (T-316, T-317): an uploaded package is
    checked with exactly the public keys the kiosks of the accepted set carry.
  -->
  <ItemGroup>
    <Compile Include="..\..\..\desktop\src\NeoPrint.Kiosk.Core\Updates\KeySets\ReleaseKeys.production.cs" Link="Releases\KeySets\ReleaseKeys.production.cs" />
    <Compile Include="..\..\..\desktop\src\NeoPrint.Kiosk.Core\Updates\KeySets\ReleaseKeys.staging.cs" Link="Releases\KeySets\ReleaseKeys.staging.cs" />
    <!-- For the layout's JSON only. Drawing it is the converter tool's job. -->
    <ProjectReference Include="..\..\shared\NeoPrint.Layout\NeoPrint.Layout.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The converter tool's client is internal; its tests run the real tool through it. -->
    <InternalsVisibleTo Include="NeoPrint.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup Label="Converter tool">
    <!--
      PDFium, SkiaSharp and PDFsharp are deliberately not referenced here: a
      user's file is parsed only by the converter tool, a separate process
      (docs/adr/ADR-0005-isolated-converter.md, ParserIsolationTests). What the
      two sides say to each other is this one file, compiled into both.
    -->
    <Compile Include="..\NeoPrint.Converter\ToolContract.cs" Link="Conversion\ToolContract.cs" />
  </ItemGroup>

</Project>
