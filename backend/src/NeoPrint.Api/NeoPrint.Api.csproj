<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Controllers, SignalR hubs, middleware and composition root.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NeoPrint.Api</RootNamespace>
    <UserSecretsId>neoprint-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <!-- Swagger UI is only registered in the Development environment. -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoPrint.Workers\NeoPrint.Workers.csproj" />
  </ItemGroup>

  <ItemGroup Label="Converter tool">
    <!--
      Shipped next to the API so the converter container - the same image -
      and a development machine can start it. The API never loads it: nothing
      here uses its types (docs/adr/ADR-0005-isolated-converter.md).
    -->
    <ProjectReference Include="..\NeoPrint.Converter\NeoPrint.Converter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NeoPrint.Api.IntegrationTests" />
  </ItemGroup>

</Project>
