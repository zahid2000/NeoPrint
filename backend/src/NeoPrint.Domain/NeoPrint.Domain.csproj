<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Entities, value objects, enums and domain events.

    Deliberately has no dependencies at all - not even on the persistence
    driver. State transitions such as PrintJob.TransitionTo() live here and are
    covered by unit tests without any infrastructure (plan sections 5 and 11).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NeoPrint.Domain</RootNamespace>
  </PropertyGroup>

  <!--
    The price formula. A pure calculation with no dependencies - shared with the
    kiosk - so the domain stays free of technology (docs/ARCHITECTURE_RULES.md)
    while a price snapshot can hold the exact inputs it was computed from.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\shared\NeoPrint.Pricing\NeoPrint.Pricing.csproj" />
    <ProjectReference Include="..\..\shared\NeoPrint.Documents\NeoPrint.Documents.csproj" />
  </ItemGroup>

</Project>
