<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Page layout renderer (plan section 2.11): turns a layout project into a PDF
    at true physical size. The same renderer runs in the backend (mobile
    layouts and scans) and locally on the kiosk, so both print the same.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NeoPrint.Layout</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT, empira (official): the PDF itself. -->
    <PackageReference Include="PDFsharp" />
    <!-- MIT, Microsoft: decoding, turning upright and reducing the pictures. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

</Project>
