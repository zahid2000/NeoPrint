# ---------------------------------------------------------------------------
# NeoPrint — the staging stack (M20, T-335, docs/DEPLOY.md section 3a).
#
# The development docker-compose.yml, run as a second project beside the
# development one on the same machine, with what makes it staging:
#
#   - Production: every mandatory secret must be in OpenBao or the API does not
#     start (T-169); the Development seed (test kiosks, dev accounts, orders)
#     never runs - only the production seed: roles, settings, legal documents,
#     the first SuperAdmin (T-300);
#   - its own OpenBao, its own data volumes (project neoprint-staging), its own
#     seed file of random credentials (.env.staging-seed, made by
#     tools/staging/staging.sh, gitignored) and its own .openbao-staging/;
#   - other container names and ports, so both stacks run at once.
#
# Nothing here is a secret. Used by tools/staging/staging.sh:
#   docker compose -p neoprint-staging --env-file deploy/staging/staging.env ...
# ---------------------------------------------------------------------------
NEOPRINT_NAME=neoprint-staging
NEOPRINT_ENVIRONMENT=Production
NEOPRINT_SEED_FILE=./.env.staging-seed
NEOPRINT_OPENBAO_DIR=./.openbao-staging

NEOPRINT_PORT_OPENBAO=28200
NEOPRINT_PORT_MONGO=27027
NEOPRINT_PORT_REDIS=26379
NEOPRINT_PORT_RABBITMQ=25672
NEOPRINT_PORT_RABBITMQ_UI=25673
NEOPRINT_PORT_RUSTFS=29000
NEOPRINT_PORT_RUSTFS_UI=29001
NEOPRINT_PORT_RUSTFS_SECONDARY=29010
NEOPRINT_PORT_SMTP=21025
NEOPRINT_PORT_MAILPIT=28025
NEOPRINT_PORT_API=25080
NEOPRINT_PORT_ADMIN=28080
