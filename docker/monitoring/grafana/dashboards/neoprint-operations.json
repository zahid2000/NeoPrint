    {
      "id": 2,
      "type": "timeseries",
      "title": "Bitməmiş refund-lar — statusa görə",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
