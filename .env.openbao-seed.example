# ---------------------------------------------------------------------------
# NeoPrint — development secrets seeded into OpenBao
#
#   cp .env.openbao-seed.example .env.openbao-seed
#
# .env.openbao-seed is in .gitignore and must never be committed.
#
# These values are for the local Docker Compose environment only. They are also
# the credentials the mongo / redis / rabbitmq / rustfs containers themselves
# start with, so compose reads this same file (see docker-compose.yml).
#
# In production nothing is seeded from a file: the operations team writes the
# secrets with `bao kv put` and openbao-init is not deployed (docs/OPENBAO.md).
#
# Routing (plan section 2.13) — openbao/init/init.sh derives the KV path from
# the key name:
#   neoprint/backend/core       NEOPRINT_MONGO_URI, NEOPRINT_REDIS,
#                               NEOPRINT_RABBITMQ_URI, NEOPRINT_JWT_SIGNING_KEY
#   neoprint/backend/crypto     NEOPRINT_KEK_*, NEOPRINT_STORAGE_SECRETS_KEY,
#                               NEOPRINT_DATA_PROTECTION_KEY, NEOPRINT_QR_HMAC_KEY
#   neoprint/backend/providers  NEOPRINT_SMTP_*, NEOPRINT_FCM_*,
#                               NEOPRINT_TELEGRAM_*, NEOPRINT_FISCAL_*, NEOPRINT_BANK_*
#   neoprint/backend/seed       NEOPRINT_STORAGE_SEED_*, NEOPRINT_SEED_ADMIN_*,
#                               NEOPRINT_DEV_*
#
# A key left empty in the "generated" group below is filled with a fresh random
# 256-bit value on first run, so no key material is shared between machines or
# checked into the repository.
#
# openbao-init compares this file with your copy on every start: a key missing
# from your copy, a key this file no longer has (an old MinIO value, say), or a
# mandatory value left empty stops it with a message saying which. The schema
# version below changes whenever keys are added, removed or change meaning;
# when yours differs, follow docs/DEV_ENVIRONMENT.md ("Seed faylı").
# ---------------------------------------------------------------------------

SEED_SCHEMA_VERSION=2

# --- Infrastructure credentials (development only) -------------------------
# These are named exactly as the official images expect them, so the containers
# can take them straight from this file with env_file and no compose-level
# variable substitution is needed. The api container deliberately does NOT read
# this file: it takes every secret from OpenBao (plan section 2.13).
MONGO_INITDB_ROOT_USERNAME=neoprint
MONGO_INITDB_ROOT_PASSWORD=devMongoPassword
REDIS_PASSWORD=devRedisPassword
RABBITMQ_DEFAULT_USER=neoprint
RABBITMQ_DEFAULT_PASS=devRabbitPassword
# RustFS, the development object store (both rustfs and rustfs-secondary).
# The names are the ones the image reads.
RUSTFS_ACCESS_KEY=neoprintrustfs
RUSTFS_SECRET_KEY=devRustfsPassword

# --- neoprint/backend/core -------------------------------------------------
NEOPRINT_MONGO_URI=mongodb://neoprint:devMongoPassword@mongo:27017/neoprint?authSource=admin&replicaSet=rs0&directConnection=true
NEOPRINT_REDIS=redis:6379,password=devRedisPassword,abortConnect=false
NEOPRINT_RABBITMQ_URI=amqp://neoprint:devRabbitPassword@rabbitmq:5672/
# Leave empty: generated on first run.
NEOPRINT_JWT_SIGNING_KEY=

# --- neoprint/backend/crypto ----------------------------------------------
# Identifier of the key encryption key new objects are wrapped with. Rotating
# means adding NEOPRINT_KEK__<new id> and pointing this at it (plan 2.13).
NEOPRINT_KEK_CURRENT_ID=k1
# Leave empty: generated on first run (base64, 256-bit).
NEOPRINT_KEK__k1=
NEOPRINT_STORAGE_SECRETS_KEY=
NEOPRINT_DATA_PROTECTION_KEY=
NEOPRINT_QR_HMAC_KEY=

# --- neoprint/backend/providers -------------------------------------------
# Mailpit, the development SMTP catcher. No credentials, no TLS.
NEOPRINT_SMTP_HOST=mailpit
NEOPRINT_SMTP_PORT=1025
NEOPRINT_SMTP_USER=
NEOPRINT_SMTP_PASSWORD=
NEOPRINT_SMTP_FROM=noreply@neoprint.local
NEOPRINT_SMTP_FROM_NAME=NeoPrint
NEOPRINT_SMTP_USE_TLS=false

# Firebase service account JSON for push. Empty in development: the backend
# falls back to LoggingPushSender instead of failing (plan section 2.1).
NEOPRINT_FCM_SERVICE_ACCOUNT_JSON=

# Telegram alerting. Empty disables it.
NEOPRINT_TELEGRAM_BOT_TOKEN=

# Fiscal provider. Mock until a real provider is chosen (plan sections 2.12, 15).
NEOPRINT_FISCAL_PROVIDER=Mock
NEOPRINT_FISCAL_API_URL=
NEOPRINT_FISCAL_API_KEY=

# Bank / card payment provider. Mock — there is no real integration in the MVP.
NEOPRINT_BANK_PROVIDER=Mock
NEOPRINT_BANK_API_URL=
NEOPRINT_BANK_API_KEY=
NEOPRINT_BANK_CALLBACK_SECRET=mock-callback-shared-secret

# --- neoprint/backend/seed -------------------------------------------------
# The first storage provider created on first start: RustFS. Every later
# change - adding rustfs-secondary for a migration, say - is made from the
# admin panel only (plan 2.10).
NEOPRINT_STORAGE_SEED_TYPE=RustFS
NEOPRINT_STORAGE_SEED_NAME=Local RustFS
NEOPRINT_STORAGE_SEED_ENDPOINT=http://rustfs:9000
NEOPRINT_STORAGE_SEED_REGION=us-east-1
NEOPRINT_STORAGE_SEED_USE_SSL=false
NEOPRINT_STORAGE_SEED_ACCESS_KEY=neoprintrustfs
NEOPRINT_STORAGE_SEED_SECRET_KEY=devRustfsPassword
NEOPRINT_STORAGE_SEED_BUCKET_FILES=neoprint-files
NEOPRINT_STORAGE_SEED_BUCKET_RECEIPTS=neoprint-receipts
NEOPRINT_STORAGE_SEED_BUCKET_TEMP=neoprint-temp

# The first SuperAdmin. Changing the password is mandatory at first login.
NEOPRINT_SEED_ADMIN_EMAIL=admin@neoprint.local
NEOPRINT_SEED_ADMIN_PASSWORD=ChangeMe!2026

# Development only: the shared password of the ready-made test accounts
# (dev-superadmin@, dev-admin@, dev-operator@, dev-finance@ and the mobile
# dev-user@neoprint.local). They are created only when the API runs in
# Development and do not have to change it (docs/DEV_ENVIRONMENT.md).
NEOPRINT_DEV_TEST_PASSWORD=DevTest!2026
