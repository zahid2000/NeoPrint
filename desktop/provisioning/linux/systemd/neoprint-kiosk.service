# NeoPrint kiosk UI (plan section 7.12).
#
# cage gives the application the whole display: a Wayland compositor with no
# desktop, no shortcuts and no notification daemon, so nothing but NeoPrint can
# put anything on screen. If the UI exits, systemd starts it again.

[Unit]
Description=NeoPrint kiosk UI
After=neoprint-agent.service systemd-user-sessions.service
Wants=neoprint-agent.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=kiosk
Group=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal

Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland

# -s: a single application, with no compositor keybindings at all.
ExecStart=/usr/bin/cage -s -- /opt/neoprint/current/NeoPrint.Kiosk

Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
