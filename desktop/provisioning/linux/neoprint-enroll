#!/bin/bash
# ---------------------------------------------------------------------------
# Gives a kiosk its enrollment token after it was copied from a golden image
# (T-327, docs/KIOSK_SETUP.md). The image carries no token; each clone is given
# one - the same one for every clone when it was made for several kiosks - and
# activates itself on its next registration, with nobody reading its screen.
#
#   sudo neoprint-enroll                    # asks for the token; it is not shown
#   sudo neoprint-enroll --from-file PATH   # reads it from a file, e.g. on the setup stick
#
# Never as an argument: an argument stays in the shell's history and in the
# process list. The UI deletes the token file once the kiosk is activated.
# ---------------------------------------------------------------------------
set -euo pipefail

DEVICE_ROOT="/var/lib/neoprint/device"
# The account the UI runs as: the one that owns its device folder.
KIOSK_USER="$(stat -c %U "$DEVICE_ROOT" 2>/dev/null || echo kiosk)"

if [ "$(id -u)" -ne 0 ]; then
    echo "neoprint-enroll: run it with sudo." >&2
    exit 1
fi

case "${1:-}" in
    --from-file)
        [ -r "${2:-}" ] || { echo "neoprint-enroll: cannot read ${2:-the file}." >&2; exit 66; }
        token="$(tr -d ' \r\n' <"$2")" ;;
    "")
        read -r -s -p "Enrollment token: " token
        echo ;;
    *)
        echo "usage: neoprint-enroll [--from-file PATH]  (the token is never an argument)" >&2
        exit 64 ;;
esac

# What the panel shows: 64 hexadecimal characters.
if ! [[ "$token" =~ ^[0-9a-f]{64}$ ]]; then
    echo "neoprint-enroll: that is not an enrollment token - it is 64 characters, 0-9 and a-f. Copy it again from the panel." >&2
    exit 65
fi

install -d -o "$KIOSK_USER" -g "$KIOSK_USER" -m 700 "$DEVICE_ROOT"
(
    umask 077
    printf '%s' "$token" >"$DEVICE_ROOT/enrollment-token.new"
)
chown "$KIOSK_USER:$KIOSK_USER" "$DEVICE_ROOT/enrollment-token.new"
mv -f "$DEVICE_ROOT/enrollment-token.new" "$DEVICE_ROOT/enrollment-token"

# The UI registers on every start: a restart is the next registration.
systemctl restart neoprint-kiosk.service >/dev/null 2>&1 || true

echo "neoprint-enroll: the token is in place; the kiosk activates itself in a moment and the panel shows it."
