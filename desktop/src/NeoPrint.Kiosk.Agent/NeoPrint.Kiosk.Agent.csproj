<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    The kiosk agent (plan section 7.12): a system service that starts before the
    UI, restarts it if it crashes, applies updates and carries out remote
    commands. Runs as LocalSystem on Windows and as the neoprint account under
    systemd on Linux.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NeoPrint.Kiosk.Agent</RootNamespace>
    <UserSecretsId>neoprint-kiosk-agent</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoPrint.Kiosk.Core\NeoPrint.Kiosk.Core.csproj" />
  </ItemGroup>

</Project>
