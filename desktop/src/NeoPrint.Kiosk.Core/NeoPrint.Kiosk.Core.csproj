<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything the kiosk does that is not UI and not platform-specific: the
    backend client, device enrollment, settings, telemetry and the real-time
    connection. Stays net8.0 and touches no platform API directly
    (plan section 7.6).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NeoPrint.Kiosk.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="QRCoder" />
    <!-- Printer-MIB page counters over SNMP (plan section 7.10, print_attempts). -->
    <PackageReference Include="Lextm.SharpSnmpLib" />
  </ItemGroup>

  <!--
    The release keys this build trusts (T-316, docs/RELEASE_SIGNING.md):
    production by default, staging only when asked for at build time with
    -p:ReleaseKeySet=staging (test server, development stack). Only the chosen
    set's file is compiled, so a production assembly carries no staging key.
  -->
  <PropertyGroup>
    <ReleaseKeySet Condition="'$(ReleaseKeySet)' == ''">production</ReleaseKeySet>
    <DefineConstants Condition="'$(ReleaseKeySet)' == 'staging'">$(DefineConstants);NEOPRINT_RELEASE_KEYS_STAGING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Updates\KeySets\**" />
    <Compile Include="Updates\KeySets\ReleaseKeys.$(ReleaseKeySet).cs" />
  </ItemGroup>

  <Target Name="CheckReleaseKeySet" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ReleaseKeySet)' != 'production' And '$(ReleaseKeySet)' != 'staging'"
           Text="ReleaseKeySet is '$(ReleaseKeySet)'; it is production or staging." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\NeoPrint.Kiosk.Platform.Abstractions\NeoPrint.Kiosk.Platform.Abstractions.csproj" />
    <!-- The kiosk shares the contracts and the pricing rules with the backend
         (plan section 4): one renderer, one price, no drift. -->
    <ProjectReference Include="..\..\..\backend\src\NeoPrint.Contracts\NeoPrint.Contracts.csproj" />
    <ProjectReference Include="..\..\..\backend\shared\NeoPrint.Pricing\NeoPrint.Pricing.csproj" />
    <ProjectReference Include="..\..\..\backend\shared\NeoPrint.Crypto\NeoPrint.Crypto.csproj" />
  </ItemGroup>

</Project>
