<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows implementations: the spooler, WMI, CNG and the registry
    (plan section 7.6). Targets net8.0-windows and is included in the win-x64
    publish only.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>NeoPrint.Kiosk.Platform.Windows</RootNamespace>
    <!-- System.Drawing.Printing for PrintDocument (plan section 7.4): part of the
         Windows Desktop runtime, not a package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoPrint.Kiosk.Platform.Abstractions\NeoPrint.Kiosk.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\backend\shared\NeoPrint.Pdfium\NeoPrint.Pdfium.csproj" />
  </ItemGroup>

</Project>
