<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
             xmlns:v="using:NeoPrint.Kiosk.Views"
             x:Class="NeoPrint.Kiosk.Views.FlowView"
             x:DataType="vm:PrintFlowViewModel">

    <!--
        The flash order and the cancel-by-code screen (plan section 7.3,
        screens 2, 3, 4, 5, 9 and 11). One primary action per stage; the error
        block says what happened, what it means and what to do; the USB badge
        is on every stage of a flash order.
    -->

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- The step indicator, the USB badge and the error, above every stage -->
        <StackPanel Grid.Row="0" Spacing="{DynamicResource Space4}" Margin="{DynamicResource GapBelow4}">
            <!-- Done: a green tick; current: a brand number; upcoming: a neutral
                 number - and always the step's name (docs/DESIGN_SYSTEM.md). -->
            <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding ShowSteps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FlowStep">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                            <PathIcon Width="32" Height="32" Data="{StaticResource IconSuccess}"
                                      Foreground="{DynamicResource Success500}" IsVisible="{Binding IsDone}" />
                            <Border Classes="step" Classes.current="{Binding IsCurrent}" IsVisible="{Binding !IsDone}">
                                <TextBlock Text="{Binding Number}" Classes="step-number" Classes.current="{Binding IsCurrent}" />
                            </Border>
                            <TextBlock Text="{Binding Label}" Classes="step-label" Classes.current="{Binding IsCurrent}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="usb" HorizontalAlignment="Left" IsVisible="{Binding IsFromDrive}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                    <PathIcon Data="{StaticResource IconUsb}" Width="24" Height="24" Foreground="{DynamicResource Info500}" />
                    <TextBlock Text="{Binding UsbText}" FontWeight="SemiBold" Foreground="{DynamicResource Info500}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UsbHint}" Classes="body-small" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                    <PathIcon Data="{StaticResource IconError}" Width="28" Height="28" Foreground="{DynamicResource Danger500}" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="1100" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Panel Grid.Row="1">

            <!-- ============ Screen 2: the files on the drive ============ -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsBrowse}}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}" Margin="{DynamicResource GapBelow4}">
                    <TextBlock Text="{Binding BrowseTitle}" Classes="h1" VerticalAlignment="Center" />
                    <Button Classes="secondary" Command="{Binding UpCommand}" IsVisible="{Binding CanGoUp}">
                        <TextBlock Text="{Binding UpText}" />
                    </Button>
                </StackPanel>

                <!-- No drive: say how to start. -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}" MaxWidth="720"
                            IsVisible="{Binding CurrentFolder, Converter={x:Static ObjectConverters.IsNull}}">
                    <PathIcon Data="{StaticResource IconUsb}" Width="80" Height="80" Foreground="{DynamicResource Info500}" />
                    <TextBlock Text="{Binding InsertTitle}" Classes="h1" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding InsertBody}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <!-- An empty folder: the empty state (section 4). -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}" MaxWidth="720">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="CurrentFolder" Converter="{x:Static ObjectConverters.IsNotNull}" />
                            <Binding Path="!Entries.Count" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <PathIcon Data="{StaticResource IconInfo}" Width="64" Height="64" Foreground="{DynamicResource Neutral400}" />
                    <TextBlock Text="{Binding EmptyText}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" IsVisible="{Binding Entries.Count}">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DriveEntry">
                                <Button Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Margin="{DynamicResource GapBelow4}"
                                        IsEnabled="{Binding IsSelectable}"
                                        Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).OpenCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                                        <PathIcon Width="32" Height="32" Foreground="{DynamicResource Brand600}"
                                                  Data="{StaticResource IconPrint}" IsVisible="{Binding !IsFolder}" />
                                        <PathIcon Width="32" Height="32" Foreground="{DynamicResource Brand600}"
                                                  Data="{StaticResource IconFolder}" IsVisible="{Binding IsFolder}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="900" />
                                            <TextBlock Text="{Binding Detail}" Classes="caption" />
                                            <TextBlock Text="{Binding Reason}" Classes="caption" Foreground="{DynamicResource Danger500}"
                                                       IsVisible="{Binding Reason, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============ Working ============ -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsWorking}}">
                <ProgressBar IsIndeterminate="True" Width="400" />
                <TextBlock Text="{Binding WorkingText}" Classes="h2" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ============ Screen 3: preview ============ -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsPreview}}">
                <TextBlock Grid.ColumnSpan="2" Text="{Binding FileName}" Classes="h1" TextTrimming="CharacterEllipsis" Margin="{DynamicResource GapBelow4}" />

                <ScrollViewer Grid.Row="1" Width="240">
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageTile">
                                <Button Classes="choice" Classes.selected="{Binding IsSelected}" Margin="{DynamicResource GapBelow4}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).ShowPageCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="{DynamicResource Space4}">
                                        <Image Source="{Binding Image}" IsVisible="{Binding HasImage}" MaxHeight="220" />
                                        <TextBlock Text="{Binding Label}" Classes="caption" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1" Grid.Column="1" Classes="card" Margin="{DynamicResource GapStart6}">
                    <Image Source="{Binding LargePage}" Stretch="Uniform" />
                </Border>
            </Grid>

            <!-- ============ Screen 4: the editor ============ -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsEdit}}">
                <TextBlock Text="{Binding EditTitle}" Classes="h1" Margin="{DynamicResource GapBelow4}" />

                <!-- Pages of a document: turn, move, remove. -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsPaged}">
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageTile">
                                <Border Classes="card" Margin="{DynamicResource GapStart4}" Width="300">
                                    <StackPanel Spacing="{DynamicResource Space4}">
                                        <Panel Height="260">
                                            <Image Source="{Binding Image}" RenderTransform="{Binding Rotate, Converter={x:Static vm:ScreenConverters.Rotation}}" />
                                        </Panel>
                                        <TextBlock Text="{Binding Label}" Classes="caption" HorizontalAlignment="Center" />
                                        <UniformGrid Columns="2">
                                            <Button Classes="secondary" Margin="{DynamicResource GapBelow4}"
                                                    Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).RotatePageCommand}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).RotateText}" />
                                            </Button>
                                            <Button Classes="secondary" Margin="{DynamicResource GapBelow4}"
                                                    Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).DeletePageCommand}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).DeleteText}" />
                                            </Button>
                                            <Button Classes="secondary"
                                                    Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).MovePageBackCommand}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).MoveBackText}" />
                                            </Button>
                                            <Button Classes="secondary"
                                                    Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).MovePageForwardCommand}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).MoveForwardText}" />
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- An image: turn it, lighten or darken it. -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" IsVisible="{Binding IsImage}">
                    <Border Classes="card">
                        <Image Source="{Binding LargePage}" Stretch="Uniform"
                               RenderTransform="{Binding Pages[0].Rotate, Converter={x:Static vm:ScreenConverters.Rotation}, FallbackValue={x:Null}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource Space4}" Margin="{DynamicResource GapStart6}">
                        <Button Classes="secondary" Command="{Binding RotateImageCommand}"><TextBlock Text="{Binding RotateText}" /></Button>
                        <Button Classes="secondary" Command="{Binding BrighterCommand}"><TextBlock Text="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).BrighterText}" /></Button>
                        <Button Classes="secondary" Command="{Binding DarkerCommand}"><TextBlock Text="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).DarkerText}" /></Button>
                        <TextBlock Text="{Binding Brightness}" Classes="caption" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- A text file: the text and the on-screen keyboard. -->
                <Grid Grid.Row="1" RowDefinitions="*,Auto" IsVisible="{Binding IsText}">
                    <!-- The keys carry their own gap (KeyGap), so the rows need none: every
                         pixel saved goes to the text. -->
                    <TextBox Text="{Binding TextContent}" AcceptsReturn="True" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeBody}"
                             Margin="{DynamicResource GapBelow4}" />
                    <StackPanel Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding KeyboardRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}" HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Classes="key"
                                                        Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).TypeCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Classes="key" Command="{Binding ToggleCapitalsCommand}"><TextBlock Text="{Binding ShiftKeyText}" /></Button>
                            <Button Classes="key" Width="480" Command="{Binding TypeSpaceCommand}"><TextBlock Text="{Binding SpaceKeyText}" /></Button>
                            <Button Classes="key" Command="{Binding TypeNewLineCommand}"><TextBlock Text="{Binding EnterKeyText}" /></Button>
                            <Button Classes="key" Command="{Binding TypeBackspaceCommand}"><TextBlock Text="{Binding BackspaceKeyText}" /></Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ Screen 4a: place on a page (plan 2.11; docs/DESIGN_SYSTEM.md, "Səhifədə yerləşdir") ============ -->
            <Grid ColumnDefinitions="560,*" RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsLayout}}">
                <Grid.Styles>
                    <Style Selector="WrapPanel.tools > Button">
                        <Setter Property="Margin" Value="{DynamicResource KeyGap}" />
                    </Style>
                </Grid.Styles>

                <TextBlock Text="{Binding LayoutTitle}" Classes="h1" Margin="{DynamicResource GapBelow4}" />
                <TextBlock Grid.Row="1" Text="{Binding LayoutHint}" Classes="muted" TextWrapping="Wrap" Margin="{DynamicResource GapBelow4}" />

                <Border Grid.Row="2" Classes="card" Margin="{DynamicResource GapBelow4}">
                    <v:LayoutCanvas Project="{Binding Layout}" Picture="{Binding LayoutPreview}"
                                    Selected="{Binding LayoutSelected}" Lines="{Binding LayoutLines}" />
                </Border>

                <!-- Always takes its line: the canvas must not change size under a moving finger. -->
                <TextBlock Grid.Row="3" Text="{Binding LayoutSizeText, TargetNullValue=' '}" Classes="h2" HorizontalAlignment="Center" />

                <!-- The tools scroll; the warnings stay below them, outside the canvas column. -->
                <Grid Grid.Column="1" Grid.RowSpan="4" RowDefinitions="*,Auto" Margin="{DynamicResource GapStart8}">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Text="{Binding LayoutSizeGroup}" Classes="h2" />
                            <WrapPanel Classes="tools" IsEnabled="{Binding HasLayoutSelection}">
                                <Button Classes="secondary" Command="{Binding LayoutSizeCommand}" CommandParameter="IdCard"><TextBlock Text="{Binding LayoutSizeIdCardText}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutSizeCommand}" CommandParameter="Photo3x4"><TextBlock Text="{Binding LayoutSizePhoto3x4Text}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutSizeCommand}" CommandParameter="Photo10x15"><TextBlock Text="{Binding LayoutSizePhoto10x15Text}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutSizeCommand}" CommandParameter="A6"><TextBlock Text="{Binding LayoutSizeA6Text}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutSizeCommand}" CommandParameter="A5"><TextBlock Text="{Binding LayoutSizeA5Text}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutSizeCommand}" CommandParameter="Fit"><TextBlock Text="{Binding LayoutSizeFitText}" /></Button>
                            </WrapPanel>

                            <TextBlock Text="{Binding LayoutTemplateGroup}" Classes="h2" />
                            <WrapPanel Classes="tools">
                                <Button Classes="secondary" Command="{Binding LayoutApplyTemplateCommand}" CommandParameter="Grid"><TextBlock Text="{Binding LayoutTemplateGridText}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutApplyTemplateCommand}" CommandParameter="Cards"><TextBlock Text="{Binding LayoutTemplateCardsText}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutApplyTemplateCommand}" CommandParameter="Photos"><TextBlock Text="{Binding LayoutTemplatePhotosText}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutApplyTemplateCommand}" CommandParameter="Centre"><TextBlock Text="{Binding LayoutTemplateCentreText}" /></Button>
                            </WrapPanel>

                            <TextBlock Text="{Binding LayoutActionGroup}" Classes="h2" />
                            <WrapPanel Classes="tools" IsEnabled="{Binding HasLayoutSelection}">
                                <Button Classes="secondary" Command="{Binding LayoutRotateCommand}"><TextBlock Text="{Binding LayoutRotateText}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutBiggerCommand}"><TextBlock Text="{Binding LayoutBiggerText}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutSmallerCommand}"><TextBlock Text="{Binding LayoutSmallerText}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutCentreCommand}"><TextBlock Text="{Binding LayoutCentreText}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutDuplicateCommand}"><TextBlock Text="{Binding LayoutDuplicateText}" /></Button>
                                <Button Classes="secondary" Command="{Binding LayoutDeleteCommand}" IsVisible="{Binding CanDeleteLayoutPicture}"><TextBlock Text="{Binding LayoutDeleteText}" /></Button>
                            </WrapPanel>

                            <TextBlock Text="{Binding LayoutPaperGroup}" Classes="h2" />
                            <WrapPanel Classes="tools">
                                <Button Classes="choice" Classes.selected="{Binding IsLayoutA4}" Command="{Binding LayoutPaperSizeCommand}" CommandParameter="A4"><TextBlock Text="A4" /></Button>
                                <Button Classes="choice" Classes.selected="{Binding IsLayoutA3}" Command="{Binding LayoutPaperSizeCommand}" CommandParameter="A3" IsVisible="{Binding CanA3}"><TextBlock Text="A3" /></Button>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Spacing="{DynamicResource Space4}">
                        <Border Classes="warning" IsVisible="{Binding LayoutEdge, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Data="{StaticResource IconWarning}" Width="28" Height="28" Foreground="{DynamicResource Warning500}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Margin="{DynamicResource GapStart4}" Text="{Binding LayoutEdge}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border Classes="error" IsVisible="{Binding LayoutOffPage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Data="{StaticResource IconError}" Width="28" Height="28" Foreground="{DynamicResource Danger500}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Margin="{DynamicResource GapStart4}" Text="{Binding LayoutOffPage}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ Screen 5: options and price ============ -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsOptions}}">
                <ScrollViewer>
                    <StackPanel Spacing="{DynamicResource Space6}">
                        <TextBlock Text="{Binding OptionsTitle}" Classes="h1" />

                        <!-- A file from the app: what was chosen there and this kiosk cannot do (plan 9.4). -->
                        <Border Classes="warning" IsVisible="{Binding PresetNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Data="{StaticResource IconWarning}" Width="28" Height="28" Foreground="{DynamicResource Warning500}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Margin="{DynamicResource GapStart4}" Text="{Binding PresetNote}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- A scan or layout: 100%, its paper, one page to a sheet (docs/DESIGN_SYSTEM.md, "Real ölçü kilidi"). -->
                        <Border Classes="info" IsVisible="{Binding RealSizeNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Data="{StaticResource IconInfo}" Width="28" Height="28" Foreground="{DynamicResource Info500}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Margin="{DynamicResource GapStart4}" Text="{Binding RealSizeNote}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border Classes="warning" IsVisible="{Binding RealSizeBlocked, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Data="{StaticResource IconWarning}" Width="28" Height="28" Foreground="{DynamicResource Warning500}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Margin="{DynamicResource GapStart4}" Text="{Binding RealSizeBlocked}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Copies -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                            <TextBlock Text="{Binding CopiesLabel}" Classes="h2" Width="{DynamicResource OptionLabelWidth}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Classes="secondary" Command="{Binding FewerCopiesCommand}"><TextBlock Text="−" /></Button>
                            <TextBlock Text="{Binding Copies}" Classes="h1" VerticalAlignment="Center" MinWidth="64" TextAlignment="Center" />
                            <Button Classes="secondary" Command="{Binding MoreCopiesCommand}"><TextBlock Text="+" /></Button>
                        </StackPanel>

                        <!-- Pages: all, or a range typed on the keypad -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                            <TextBlock Text="{Binding PagesLabel}" Classes="h2" Width="{DynamicResource OptionLabelWidth}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Classes="choice" Classes.selected="{Binding AllPages}" Command="{Binding ChooseAllPagesCommand}">
                                <TextBlock Text="{Binding AllPagesText}" />
                            </Button>
                            <Button Classes="choice" Classes.selected="{Binding !AllPages}" Command="{Binding ChooseRangeCommand}">
                                <TextBlock Text="{Binding RangeLabel}" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}" IsVisible="{Binding !AllPages}" Margin="{DynamicResource GapStart12}">
                            <StackPanel Spacing="{DynamicResource Space4}">
                                <Border Classes="card" MinWidth="320">
                                    <TextBlock Text="{Binding RangeText}" Classes="h2" />
                                </Border>
                                <TextBlock Text="{Binding RangeHint}" Classes="caption"
                                           IsVisible="{Binding RangeProblem, Converter={x:Static ObjectConverters.IsNull}}" />
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}" MaxWidth="320"
                                            IsVisible="{Binding RangeProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <PathIcon Data="{StaticResource IconError}" Width="28" Height="28" Foreground="{DynamicResource Danger500}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding RangeProblem}" Classes="caption" Foreground="{DynamicResource Danger500}" TextWrapping="Wrap" MaxWidth="276" />
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding RangeKeys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <!-- "," and "-" are drawn large (Button.key.symbol): at digit size they are a speck. -->
                                            <Button Classes="key"
                                                    Classes.symbol="{Binding Converter={x:Static vm:ScreenConverters.IsSymbolKey}}"
                                                    Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).RangeKeyCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            <Button Classes="key" Command="{Binding RangeEraseCommand}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding BackspaceKeyText}" />
                            </Button>
                        </StackPanel>

                        <!-- Colour -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                            <TextBlock Text="{Binding ColourLabel}" Classes="h2" Width="{DynamicResource OptionLabelWidth}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Classes="choice" Classes.selected="{Binding !Color}" Command="{Binding ChooseColorCommand}" CommandParameter="false">
                                <TextBlock Text="{Binding BwText}" />
                            </Button>
                            <Button Classes="choice" Classes.selected="{Binding Color}" Command="{Binding ChooseColorCommand}" CommandParameter="true"
                                    IsEnabled="{Binding CanColor}">
                                <TextBlock Text="{Binding ColorText}" />
                            </Button>
                            <TextBlock Text="{Binding UnavailableText}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding !CanColor}" />
                        </StackPanel>

                        <!-- Sides -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                            <TextBlock Text="{Binding SidesLabel}" Classes="h2" Width="{DynamicResource OptionLabelWidth}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Classes="choice" Classes.selected="{Binding !Duplex}" Command="{Binding ChooseDuplexCommand}" CommandParameter="false">
                                <TextBlock Text="{Binding SimplexText}" />
                            </Button>
                            <Button Classes="choice" Classes.selected="{Binding Duplex}" Command="{Binding ChooseDuplexCommand}" CommandParameter="true"
                                    IsEnabled="{Binding CanDuplex}">
                                <TextBlock Text="{Binding DuplexText}" />
                            </Button>
                            <TextBlock Text="{Binding UnavailableText}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding !CanDuplex}" />
                        </StackPanel>

                        <!-- Paper -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}" IsEnabled="{Binding CanChooseSheet}">
                            <TextBlock Text="{Binding PaperLabel}" Classes="h2" Width="{DynamicResource OptionLabelWidth}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Classes="choice" Classes.selected="{Binding Paper, Converter={x:Static vm:ScreenConverters.IsA4}}"
                                    Command="{Binding ChoosePaperCommand}" CommandParameter="A4">
                                <TextBlock Text="A4" />
                            </Button>
                            <Button Classes="choice" Classes.selected="{Binding Paper, Converter={x:Static vm:ScreenConverters.IsA3}}"
                                    Command="{Binding ChoosePaperCommand}" CommandParameter="A3" IsEnabled="{Binding CanA3}">
                                <TextBlock Text="A3" />
                            </Button>
                            <TextBlock Text="{Binding UnavailableText}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding !CanA3}" />
                        </StackPanel>

                        <!-- Pages per sheet -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}" IsEnabled="{Binding CanChooseSheet}">
                            <TextBlock Text="{Binding PerSheetLabel}" Classes="h2" Width="{DynamicResource OptionLabelWidth}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Classes="choice" Classes.selected="{Binding PagesPerSheet, Converter={x:Static vm:ScreenConverters.IsOne}}"
                                    Command="{Binding ChoosePerSheetCommand}" CommandParameter="1"><TextBlock Text="1" /></Button>
                            <Button Classes="choice" Classes.selected="{Binding PagesPerSheet, Converter={x:Static vm:ScreenConverters.IsTwo}}"
                                    Command="{Binding ChoosePerSheetCommand}" CommandParameter="2"><TextBlock Text="2" /></Button>
                            <Button Classes="choice" Classes.selected="{Binding PagesPerSheet, Converter={x:Static vm:ScreenConverters.IsFour}}"
                                    Command="{Binding ChoosePerSheetCommand}" CommandParameter="4"><TextBlock Text="4" /></Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The live price: the kiosk's profile, volume discount included; the
                     promo code below it (docs/DESIGN_SYSTEM.md, "Promokod sahəsi"). -->
                <StackPanel Grid.Column="1" Width="{DynamicResource PayMethodWidth}" Spacing="{DynamicResource Space4}" Margin="{DynamicResource GapStart8}">
                    <Border Classes="card" VerticalAlignment="Top">
                        <StackPanel Spacing="{DynamicResource Space4}">
                            <TextBlock Text="{Binding PriceLabel}" Classes="muted" />
                            <TextBlock Text="{Binding PriceText}" Classes="display"
                                       IsVisible="{Binding PriceText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{Binding QuoteDetail}" Classes="body-small" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}"
                                        IsVisible="{Binding PromoLine, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <PathIcon Data="{StaticResource IconSuccess}" Width="28" Height="28" Foreground="{DynamicResource Success500}" />
                                <TextBlock Text="{Binding PromoLine}" Foreground="{DynamicResource Success500}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding AmountDueText}" Classes="h2"
                                       IsVisible="{Binding AmountDueText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <Button Classes="secondary" Command="{Binding EditPromoCommand}" IsVisible="{Binding CanEditPromo}">
                            <TextBlock Text="{Binding PromoButtonText}" />
                        </Button>
                        <Button Classes="secondary" Command="{Binding RemovePromoCommand}" IsVisible="{Binding AppliedPromo, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding PromoRemoveText}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============ Screen 6: how to pay ============ -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsPaymentMethod}}">
                <TextBlock Text="{Binding PayTitle}" Classes="h1" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PayAmountLabel}" Classes="muted" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PayAmountText}" Classes="display" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PayPromoText}" Foreground="{DynamicResource Success500}" HorizontalAlignment="Center"
                           IsVisible="{Binding PayPromoText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}" HorizontalAlignment="Center">
                    <Button Classes="pay-method" Command="{Binding PayWithBankCommand}">
                        <StackPanel Spacing="{DynamicResource Space4}">
                            <PathIcon Data="{StaticResource IconCard}" Width="64" Height="64" Foreground="{DynamicResource Brand600}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding PayBankText}" Classes="h2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PayBankHint}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Classes="pay-method" Command="{Binding PayWithAppCommand}" IsVisible="{Binding CanPayWithApp}">
                        <StackPanel Spacing="{DynamicResource Space4}">
                            <PathIcon Data="{StaticResource IconPhone}" Width="64" Height="64" Foreground="{DynamicResource Brand600}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding PayAppText}" Classes="h2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PayAppHint}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- ============ Screens 7–8: the QR and the countdown ============ -->
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" HorizontalAlignment="Center"
                  IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsQrPayment}}">
                <Border Classes="qr" IsVisible="{Binding QrContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Image Source="{Binding QrContent, Converter={x:Static vm:ScreenConverters.QrImage}}"
                           Width="{DynamicResource PaymentQrSize}" Height="{DynamicResource PaymentQrSize}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource Space6}" Margin="{DynamicResource GapStart12}" MaxWidth="760" VerticalAlignment="Center">
                    <Border Classes="warning" IsVisible="{Binding PayNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                            <PathIcon Data="{StaticResource IconWarning}" Width="28" Height="28" Foreground="{DynamicResource Warning500}" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding PayNotice}" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding PayAmountLabel}" Classes="muted" />
                    <TextBlock Text="{Binding PayAmountText}" Classes="display" />
                    <TextBlock Text="{Binding PayPromoText}" Foreground="{DynamicResource Success500}"
                               IsVisible="{Binding PayPromoText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding PayInstruction}" Classes="h2" TextWrapping="Wrap" />
                    <!-- The countdown: a large number with words; the last minute in warning colour and with its icon. -->
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <PathIcon Data="{StaticResource IconWarning}" Width="32" Height="32" Foreground="{DynamicResource Warning500}" IsVisible="{Binding CountdownLow}" />
                        <TextBlock Text="{Binding CountdownText}" Classes="h1" Classes.warning="{Binding CountdownLow}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <ProgressBar IsIndeterminate="True" Width="160" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PayWaitingText}" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============ The time ran out, or the bank said no ============ -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}" MaxWidth="820"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsPaymentExpired}}">
                <Border Width="{DynamicResource StatusIconSize}" Height="{DynamicResource StatusIconSize}" Background="{DynamicResource WarningBg}"
                        CornerRadius="{DynamicResource StatusIconRadius}" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconWarning}" Width="60" Height="60" Foreground="{DynamicResource Warning500}" />
                </Border>
                <TextBlock Text="{Binding ExpiredTitle}" Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ExpiredBody}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>

            <!-- ============ Screen 9: paid (or queued) - the receipt ============ -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"
                  IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsPlaced}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}" MaxWidth="820">
                    <Border Width="{DynamicResource StatusIconSize}" Height="{DynamicResource StatusIconSize}" Background="{DynamicResource SuccessBg}"
                            CornerRadius="{DynamicResource StatusIconRadius}" HorizontalAlignment="Center" IsVisible="{Binding !PrinterStopped}">
                        <PathIcon Data="{StaticResource IconSuccess}" Width="60" Height="60" Foreground="{DynamicResource Success500}" />
                    </Border>
                    <!-- The printer stopped this order and it was refunded (T-133). -->
                    <Border Width="{DynamicResource StatusIconSize}" Height="{DynamicResource StatusIconSize}" Background="{DynamicResource WarningBg}"
                            CornerRadius="{DynamicResource StatusIconRadius}" HorizontalAlignment="Center" IsVisible="{Binding PrinterStopped}">
                        <PathIcon Data="{StaticResource IconWarning}" Width="60" Height="60" Foreground="{DynamicResource Warning500}" />
                    </Border>
                    <TextBlock Text="{Binding PlacedHeading}" Classes="h1" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding PlacedCodeLabel}" Classes="muted" HorizontalAlignment="Center" />
                    <Border Background="{DynamicResource Brand50}" CornerRadius="{DynamicResource RadiusLg}" Padding="{DynamicResource CodeBoxPadding}" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PlacedCode}" FontSize="{DynamicResource FontSizeCode}" FontWeight="SemiBold" Foreground="{DynamicResource Brand700}" />
                    </Border>
                    <StackPanel Spacing="{DynamicResource Space6}" IsVisible="{Binding !PrinterStopped}">
                        <TextBlock Text="{Binding PlacedPosition}" Classes="h2" HorizontalAlignment="Center"
                                   IsVisible="{Binding PlacedPosition, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding KeepCodeText}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding AppNoteText}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding PaidWithApp}" />
                    </StackPanel>

                    <!-- RefundInfo on the receipt screen: what goes back, where, and the QR to follow it. -->
                    <Border Classes="card" IsVisible="{Binding PrinterStopped}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                            <Border Classes="qr" IsVisible="{Binding RefundQr, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Image Source="{Binding RefundQr, Converter={x:Static vm:ScreenConverters.QrImage}}"
                                       Width="{DynamicResource RefundQrSize}" Height="{DynamicResource RefundQrSize}" />
                            </Border>
                            <StackPanel Spacing="{DynamicResource Space4}" VerticalAlignment="Center" MaxWidth="440">
                                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                                    <PathIcon Data="{StaticResource IconInfo}" Width="32" Height="32" Foreground="{DynamicResource Info500}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding RefundText}" Classes="h2" TextWrapping="Wrap" MaxWidth="390" />
                                </StackPanel>
                                <TextBlock Text="{Binding RefundScanText}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- The fiscal receipt and "email me the receipt": only for a paid order. -->
                <StackPanel Grid.Column="1" Spacing="{DynamicResource Space6}" Margin="{DynamicResource GapStart12}" Width="{DynamicResource PayMethodWidth}"
                            IsVisible="{Binding HasPayment}">
                    <Border Classes="card">
                        <StackPanel Spacing="{DynamicResource Space4}">
                            <TextBlock Text="{Binding FiscalTitle}" Classes="h2" />
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}" IsVisible="{Binding HasFiscalQr}">
                                <Border Classes="qr">
                                    <Image Source="{Binding FiscalQr, Converter={x:Static vm:ScreenConverters.QrImage}}"
                                           Width="{DynamicResource ReceiptQrSize}" Height="{DynamicResource ReceiptQrSize}" />
                                </Border>
                                <TextBlock Text="{Binding FiscalScanText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="180" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}" IsVisible="{Binding !HasFiscalQr}">
                                <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" IsVisible="{Binding FiscalPending}" />
                                <TextBlock Text="{Binding FiscalPendingText}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="{DynamicResource Space4}">
                            <TextBlock Text="{Binding EmailTitle}" Classes="h2" />
                            <!-- The keyboard opens on its own sheet: it does not fit this column. -->
                            <Button Classes="secondary" Command="{Binding OpenEmailCommand}" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding EmailOpenText}" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}"
                                        IsVisible="{Binding EmailSent, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <PathIcon Data="{StaticResource IconSuccess}" Width="28" Height="28" Foreground="{DynamicResource Success500}" />
                                <TextBlock Text="{Binding EmailSent}" Classes="caption" Foreground="{DynamicResource Success500}" TextWrapping="Wrap" MaxWidth="460" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============ Screen 10: the user's files, after their QR (plan 9.4) ============ -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsUserFiles}}">
                <StackPanel Spacing="{DynamicResource Space4}" Margin="{DynamicResource GapBelow4}">
                    <TextBlock Text="{Binding UserFilesTitle}" Classes="h1" />
                    <TextBlock Text="{Binding UserFilesBody}" Classes="muted" IsVisible="{Binding HasUserFiles}" />
                </StackPanel>

                <!-- Nothing prepared: the empty state says what to do in the app. -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}" MaxWidth="820"
                            IsVisible="{Binding HasNoUserFiles}">
                    <PathIcon Data="{StaticResource IconPhone}" Width="80" Height="80" Foreground="{DynamicResource Neutral400}" />
                    <TextBlock Text="{Binding UserFilesEmpty}" Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UserFilesEmptyHint}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding UserFiles}" IsVisible="{Binding HasUserFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UserFileCard">
                            <Border Classes="card" Classes.off="{Binding !IsPrintable}" Margin="{DynamicResource GapBelow4}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Width="40" Height="40" Foreground="{DynamicResource Brand600}" Data="{StaticResource IconPrint}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="{DynamicResource Space4}" Margin="{DynamicResource GapStart6}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Classes="h2" TextTrimming="CharacterEllipsis" MaxWidth="900" HorizontalAlignment="Left" />
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                                            <TextBlock Text="{Binding Detail}" Classes="caption" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Amount}" Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       IsVisible="{Binding Amount, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}" IsVisible="{Binding IsPaid}">
                                                <PathIcon Data="{StaticResource IconSuccess}" Width="24" Height="24" Foreground="{DynamicResource Success500}" />
                                                <TextBlock Text="{Binding PaidText}" Classes="caption" Foreground="{DynamicResource Success500}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}"
                                                    IsVisible="{Binding Reason, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <PathIcon Data="{StaticResource IconInfo}" Width="24" Height="24" Foreground="{DynamicResource Neutral600}" />
                                            <TextBlock Text="{Binding Reason}" Classes="caption" TextWrapping="Wrap" MaxWidth="900" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center" IsVisible="{Binding IsPrintable}"
                                            Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).PickUserFileCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding ActionText}" Foreground="{DynamicResource Neutral0}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ============ Collected: an order paid in the app, now in the queue ============ -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}" MaxWidth="820"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsCollected}}">
                <Border Width="{DynamicResource StatusIconSize}" Height="{DynamicResource StatusIconSize}" Background="{DynamicResource SuccessBg}"
                        CornerRadius="{DynamicResource StatusIconRadius}" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconSuccess}" Width="60" Height="60" Foreground="{DynamicResource Success500}" />
                </Border>
                <TextBlock Text="{Binding CollectedTitle}" Classes="h1" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PlacedCodeLabel}" Classes="muted" HorizontalAlignment="Center" />
                <Border Background="{DynamicResource Brand50}" CornerRadius="{DynamicResource RadiusLg}" Padding="{DynamicResource CodeBoxPadding}" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CollectedCode}" FontSize="{DynamicResource FontSizeCode}" FontWeight="SemiBold" Foreground="{DynamicResource Brand700}" />
                </Border>
                <TextBlock Text="{Binding CollectedPosition}" Classes="h2" HorizontalAlignment="Center"
                           IsVisible="{Binding CollectedPosition, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding CollectedBody}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>

            <!-- ============ Screen 11: cancel by code ============ -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsCancelLookup}}">
                <TextBlock Text="{Binding CancelTitle}" Classes="h1" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EnterCodeText}" Classes="muted" HorizontalAlignment="Center" />
                <Border Background="{DynamicResource Brand50}" CornerRadius="{DynamicResource RadiusLg}" Padding="{DynamicResource CodeBoxPadding}"
                        HorizontalAlignment="Center" MinWidth="480">
                    <TextBlock Text="{Binding CodeInput}" FontSize="{DynamicResource FontSizeCode}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brand700}" HorizontalAlignment="Center" />
                </Border>
                <UniformGrid Columns="3" HorizontalAlignment="Center">
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="1"><TextBlock Text="1" /></Button>
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="2"><TextBlock Text="2" /></Button>
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="3"><TextBlock Text="3" /></Button>
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="4"><TextBlock Text="4" /></Button>
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="5"><TextBlock Text="5" /></Button>
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="6"><TextBlock Text="6" /></Button>
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="7"><TextBlock Text="7" /></Button>
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="8"><TextBlock Text="8" /></Button>
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="9"><TextBlock Text="9" /></Button>
                    <Panel />
                    <Button Classes="key" Command="{Binding DigitCommand}" CommandParameter="0"><TextBlock Text="0" /></Button>
                    <Button Classes="key" Command="{Binding EraseCommand}"><TextBlock Text="{Binding BackspaceKeyText}" /></Button>
                </UniformGrid>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}" MaxWidth="820"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsCancelConfirm}}">
                <Border Width="120" Height="120" Background="{DynamicResource WarningBg}" CornerRadius="60" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconWarning}" Width="60" Height="60" Foreground="{DynamicResource Warning500}" />
                </Border>
                <TextBlock Text="{Binding CancelTitle}" Classes="h1" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding FoundSummary}" Classes="h2" HorizontalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ConfirmCancelBody}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource Space6}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsCancelDone}}">
                <Border Width="120" Height="120" Background="{DynamicResource SuccessBg}" CornerRadius="60" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconSuccess}" Width="60" Height="60" Foreground="{DynamicResource Success500}" />
                </Border>
                <TextBlock Text="{Binding CancelDoneText}" Classes="h1" HorizontalAlignment="Center" />

                <!-- RefundInfo: what goes back, where, and the QR to follow it. -->
                <Border Classes="card" IsVisible="{Binding HasRefund}" MaxWidth="1100">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                        <Border Classes="qr" IsVisible="{Binding RefundQr, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Image Source="{Binding RefundQr, Converter={x:Static vm:ScreenConverters.QrImage}}"
                                   Width="{DynamicResource ReceiptQrSize}" Height="{DynamicResource ReceiptQrSize}" />
                        </Border>
                        <StackPanel Spacing="{DynamicResource Space4}" VerticalAlignment="Center" MaxWidth="640">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                                <PathIcon Data="{StaticResource IconInfo}" Width="32" Height="32" Foreground="{DynamicResource Info500}" />
                                <TextBlock Text="{Binding RefundText}" Classes="h2" TextWrapping="Wrap" MaxWidth="590" />
                            </StackPanel>
                            <TextBlock Text="{Binding RefundScanText}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ Typing sheets (docs/DESIGN_SYSTEM.md, "Yazma paneli") ============
                 A full keyboard is wider than a side column, so the promo code and the
                 receipt email are typed on a sheet over the whole content area; the
                 action row below is hidden meanwhile (IsTyping). -->
            <Border Background="{DynamicResource Neutral50}" IsVisible="{Binding PromoEditing}">
                <Grid RowDefinitions="*,Auto">
                    <StackPanel Spacing="{DynamicResource Space6}">
                        <TextBlock Text="{Binding PromoButtonText}" Classes="h1" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                            <Border Classes="card" Width="{DynamicResource PayMethodWidth}" MinHeight="{DynamicResource TouchTarget}">
                                <TextBlock Text="{Binding PromoInput}" Classes="h2" />
                            </Border>
                            <Button Classes="primary" Command="{Binding ApplyPromoCommand}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PromoApplyText}" Foreground="{DynamicResource Neutral0}" />
                            </Button>
                            <!-- Beside the field, not under it: the keys stay where the finger is. -->
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}" VerticalAlignment="Center"
                                        IsVisible="{Binding PromoProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <PathIcon Data="{StaticResource IconError}" Width="28" Height="28" Foreground="{DynamicResource Danger500}" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding PromoProblem}" Classes="caption" Foreground="{DynamicResource Danger500}" TextWrapping="Wrap" MaxWidth="560" />
                            </StackPanel>
                        </StackPanel>
                        <!-- Capitals, digits and the dash; "Sil" beside the keys. -->
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding PromoKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button Classes="key"
                                                            Classes.symbol="{Binding Converter={x:Static vm:ScreenConverters.IsSymbolKey}}"
                                                            Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).PromoKeyCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="key" Command="{Binding PromoEraseCommand}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding BackspaceKeyText}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Row="1" Classes="secondary" HorizontalAlignment="Left" Margin="{DynamicResource GapBelow4}"
                            Command="{Binding CloseKeyboardCommand}">
                        <TextBlock Text="{Binding CloseKeyboardText}" />
                    </Button>
                </Grid>
            </Border>

            <Border Background="{DynamicResource Neutral50}" IsVisible="{Binding EmailEditing}">
                <Grid RowDefinitions="*,Auto">
                    <StackPanel Spacing="{DynamicResource Space6}">
                        <TextBlock Text="{Binding EmailTitle}" Classes="h1" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                            <Border Classes="card" Width="{DynamicResource PayMethodWidth}" MinHeight="{DynamicResource TouchTarget}">
                                <TextBlock Text="{Binding EmailInput}" Classes="h2" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Classes="primary" Command="{Binding SendEmailCommand}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EmailSendText}" Foreground="{DynamicResource Neutral0}" />
                            </Button>
                            <!-- Beside the field, not under it: the keys stay where the finger is. -->
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}" VerticalAlignment="Center"
                                        IsVisible="{Binding EmailProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <PathIcon Data="{StaticResource IconError}" Width="28" Height="28" Foreground="{DynamicResource Danger500}" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding EmailProblem}" Classes="caption" Foreground="{DynamicResource Danger500}" TextWrapping="Wrap" MaxWidth="560" />
                            </StackPanel>
                        </StackPanel>
                        <!-- What an address is made of, with "@", ".", "-" and "_"; "Sil" beside the keys. -->
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding EmailKeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button Classes="key"
                                                            Classes.symbol="{Binding Converter={x:Static vm:ScreenConverters.IsSymbolKey}}"
                                                            Command="{Binding $parent[UserControl].((vm:PrintFlowViewModel)DataContext).EmailKeyCommand}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="key" Command="{Binding EmailEraseCommand}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding BackspaceKeyText}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Row="1" Classes="secondary" HorizontalAlignment="Left" Margin="{DynamicResource GapBelow4}"
                            Command="{Binding CloseKeyboardCommand}">
                        <TextBlock Text="{Binding CloseKeyboardText}" />
                    </Button>
                </Grid>
            </Border>
        </Panel>

        <!-- The actions: secondary on the left, the one primary on the right -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="{DynamicResource GapBelow4}" IsVisible="{Binding !IsTyping}">

            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                <!-- Browse / cancel lookup / placed: leave -->
                <Button Classes="secondary" Command="{Binding LeaveCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsBrowse}" />
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsCancelLookup}" />
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsUserFiles}" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <TextBlock Text="{Binding BackText}" />
                </Button>
                <!-- Screen 10: more than five files are paged (docs/DESIGN_SYSTEM.md §5.1). -->
                <Button Classes="secondary" Command="{Binding PreviousUserPageCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsUserFiles}" />
                            <Binding Path="HasEarlierUserFiles" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <TextBlock Text="{Binding PreviousPageText}" />
                </Button>
                <Button Classes="secondary" Command="{Binding NextUserPageCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsUserFiles}" />
                            <Binding Path="HasMoreUserFiles" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <TextBlock Text="{Binding NextPageText}" />
                </Button>
                <Button Classes="secondary" Command="{Binding BackToBrowseCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsPreview}}">
                    <TextBlock Text="{Binding BackText}" />
                </Button>
                <Button Classes="secondary" Command="{Binding EditCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsPreview}" />
                            <Binding Path="CanEditFile" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <TextBlock Text="{Binding EditText}" />
                </Button>
                <Button Classes="secondary" Command="{Binding StartLayoutCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsPreview}" />
                            <Binding Path="CanStartLayout" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <TextBlock Text="{Binding LayoutStartText}" />
                </Button>
                <Button Classes="secondary" Command="{Binding LayoutCancelCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsLayout}}">
                    <TextBlock Text="{Binding CancelText}" />
                </Button>
                <Button Classes="secondary" Command="{Binding CancelEditCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsEdit}}">
                    <TextBlock Text="{Binding CancelText}" />
                </Button>
                <Button Classes="secondary" Command="{Binding ShowPreviewCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsOptions}}">
                    <TextBlock Text="{Binding BackText}" />
                </Button>
                <Button Classes="secondary" Command="{Binding StartCancelAgainCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsCancelConfirm}}">
                    <TextBlock Text="{Binding BackText}" />
                </Button>
                <!-- Paying: another way, or cancel the order - nothing was taken yet. -->
                <Button Classes="secondary" Command="{Binding ChangeMethodCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsQrPayment}}">
                    <TextBlock Text="{Binding OtherMethodText}" />
                </Button>
                <Button Classes="secondary" Command="{Binding CancelOrderCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsPaymentMethod}" />
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsQrPayment}" />
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsPaymentExpired}" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <TextBlock Text="{Binding CancelOrderText}" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                <Button Classes="primary" Command="{Binding ContinueCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsPreview}}">
                    <TextBlock Text="{Binding ContinueText}" Foreground="{DynamicResource Neutral0}" />
                </Button>
                <Button Classes="primary" Command="{Binding SaveEditCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsEdit}}">
                    <TextBlock Text="{Binding SaveText}" Foreground="{DynamicResource Neutral0}" />
                </Button>
                <Button Classes="primary" Command="{Binding LayoutDoneCommand}" IsEnabled="{Binding CanFinishLayout}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsLayout}}">
                    <TextBlock Text="{Binding LayoutDoneText}" Foreground="{DynamicResource Neutral0}" />
                </Button>
                <Button Classes="primary" Command="{Binding PlaceCommand}" IsEnabled="{Binding CanPlace}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsOptions}}">
                    <TextBlock Text="{Binding PlaceText}" Foreground="{DynamicResource Neutral0}" />
                </Button>
                <Button Classes="primary" Command="{Binding FindCommand}" IsEnabled="{Binding CanFind}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsCancelLookup}}">
                    <TextBlock Text="{Binding FindText}" Foreground="{DynamicResource Neutral0}" />
                </Button>
                <Button Classes="primary" Command="{Binding RetryPaymentCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsPaymentExpired}}">
                    <TextBlock Text="{Binding RetryText}" Foreground="{DynamicResource Neutral0}" />
                </Button>
                <Button Classes="danger" Command="{Binding ConfirmCancelCommand}"
                        IsVisible="{Binding Stage, Converter={x:Static vm:ScreenConverters.IsCancelConfirm}}">
                    <TextBlock Text="{Binding ConfirmCancelText}" Foreground="{DynamicResource Neutral0}" />
                </Button>
                <Button Classes="primary" Command="{Binding LeaveCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsPlaced}" />
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsCancelDone}" />
                            <Binding Path="Stage" Converter="{x:Static vm:ScreenConverters.IsCollected}" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <TextBlock Text="{Binding DoneText}" Foreground="{DynamicResource Neutral0}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
