<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
             x:Class="NeoPrint.Kiosk.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">

    <!--
        Screen 1 (plan section 7.3). The actions themselves land with the print
        flow in step 3; what is settled here is the layout and the touch target
        size - this is a finger on a kiosk, not a mouse.
    -->

    <StackPanel VerticalAlignment="Center" Spacing="24" MaxWidth="860">
        <TextBlock Text="{Binding HomeTitle}" Classes="h1" />

        <!-- Each action is a card-sized button with its own icon: three
             identical grey bars would read as one block from standing
             distance (docs/DESIGN_SYSTEM.md section 5.1). -->
        <Button Classes="primary"
                MinHeight="112" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Padding="32,0"
                IsEnabled="False">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <PathIcon Data="{StaticResource IconUsb}" Width="40" Height="40" />
                <TextBlock Text="{Binding PrintFromUsbText}"
                           FontSize="{DynamicResource FontSizeButton}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Neutral0}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Classes="secondary"
                MinHeight="112" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Padding="32,0"
                IsEnabled="False">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <PathIcon Data="{StaticResource IconQrCode}" Width="40" Height="40" />
                <TextBlock Text="{Binding ScanMyQrText}"
                           FontSize="{DynamicResource FontSizeButton}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Classes="secondary"
                MinHeight="112" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Padding="32,0"
                IsEnabled="False">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <PathIcon Data="{StaticResource IconInfo}" Width="40" Height="40" />
                <TextBlock Text="{Binding CancelByCodeText}"
                           FontSize="{DynamicResource FontSizeButton}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
