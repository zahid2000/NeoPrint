<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
             x:Class="NeoPrint.Kiosk.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">

    <!--
        Screen 1 (plan section 7.3): print from a flash drive, cancel an order by
        its code. Card-sized targets - this is a finger on a kiosk, not a mouse.
    -->

    <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource Space6}" MaxWidth="860">
        <!-- RefundInfo (plan sections 2.5, 7.3): the printer stopped a paid order and
             the backend is giving the money back - what, where, and how to follow it. -->
        <Border Classes="card" IsVisible="{Binding HasRefundNotice}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                <Border Classes="qr">
                    <Image Source="{Binding RefundNoticeQr, Converter={x:Static vm:ScreenConverters.QrImage}}"
                           Width="{DynamicResource ReceiptQrSize}" Height="{DynamicResource ReceiptQrSize}" />
                </Border>
                <StackPanel Spacing="{DynamicResource Space4}" VerticalAlignment="Center" MaxWidth="520">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <PathIcon Data="{StaticResource IconInfo}" Width="32" Height="32" Foreground="{DynamicResource Info500}" />
                        <TextBlock Text="{Binding RefundNoticeTitle}" Classes="h2" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding RefundNoticeBody}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RefundNoticeScan}" Classes="muted" TextWrapping="Wrap" />
                    <Button Classes="secondary" Command="{Binding DismissRefundCommand}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding RefundNoticeDone}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding HomeTitle}" Classes="h1" />

        <!-- Each action is a card-sized button with its own icon: three
             identical grey bars would read as one block from standing
             distance (docs/DESIGN_SYSTEM.md section 5.1). -->
        <!-- Shown wherever an order can be completed and paid (step 4; T-060
             kept it off the screen until payments existed). -->
        <Button Classes="primary"
                MinHeight="112" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Padding="{DynamicResource InsetX8}"
                Command="{Binding PrintFromUsbCommand}"
                IsVisible="{Binding CanPrintFromFlash}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                <PathIcon Data="{StaticResource IconUsb}" Width="40" Height="40" />
                <TextBlock Text="{Binding PrintFromUsbText}"
                           FontSize="{DynamicResource FontSizeButton}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Neutral0}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Personal QR printing arrives in step 5 (user_qr_print); until then the
             button is not on screen at all (docs/DESIGN_SYSTEM.md, "Hazır olmayan
             funksiya"). -->
        <Button Classes="secondary" IsVisible="False"
                MinHeight="112" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Padding="{DynamicResource InsetX8}"
                IsEnabled="False">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                <PathIcon Data="{StaticResource IconQrCode}" Width="40" Height="40" />
                <TextBlock Text="{Binding ScanMyQrText}"
                           FontSize="{DynamicResource FontSizeButton}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Button Classes="secondary"
                MinHeight="112" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left" Padding="{DynamicResource InsetX8}"
                Command="{Binding CancelByCodeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                <PathIcon Data="{StaticResource IconInfo}" Width="40" Height="40" />
                <TextBlock Text="{Binding CancelByCodeText}"
                           FontSize="{DynamicResource FontSizeButton}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
