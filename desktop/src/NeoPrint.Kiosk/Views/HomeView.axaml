<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
             x:Class="NeoPrint.Kiosk.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">

    <!--
        Screen 1 (plan section 7.3; the poster's "1. Welcome", T-371): the big line
        and a printer on the right, the ways a file comes in as cards with an
        arrow, cancelling by code as quiet words, and what the kiosk offers along
        the bottom. The printer's state and the queue are on the footer (T-370).
    -->

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="{DynamicResource Space6}" MaxWidth="1600">
        <!-- RefundInfo (plan sections 2.5, 7.3): the printer stopped a paid order and
             the backend is giving the money back - what, where, and how to follow it. -->
        <Border Grid.Row="0" Classes="card" IsVisible="{Binding HasRefundNotice}">
            <!-- The text takes what the QR leaves and wraps there: it must not run past the card (T-238). -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space6}">
                <Border Grid.Column="0" Classes="qr" VerticalAlignment="Center">
                    <Image Source="{Binding RefundNoticeQr, Converter={x:Static vm:ScreenConverters.QrImage}}"
                           Width="{DynamicResource ReceiptQrSize}" Height="{DynamicResource ReceiptQrSize}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource Space4}" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconInfo}" Width="32" Height="32"
                                  VerticalAlignment="Top" Foreground="{DynamicResource Info500}" />
                        <TextBlock Grid.Column="1" Text="{Binding RefundNoticeTitle}" Classes="h2" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding RefundNoticeBody}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RefundNoticeScan}" Classes="muted" TextWrapping="Wrap" />
                    <Button Classes="secondary" Command="{Binding DismissRefundCommand}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding RefundNoticeDone}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The big line on the left, the printer on the right (the poster's hero). -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" IsVisible="{Binding !HasRefundNotice}">
            <StackPanel Spacing="{DynamicResource Space4}" VerticalAlignment="Center">
                <TextBlock Text="{Binding HeroTitle}" Classes="hero" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding HeroSubtitle}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Panel Grid.Column="1" Classes="hero-art">
                <Ellipse Fill="{DynamicResource Brand100}" Width="300" Height="300" />
                <Border Classes="hero-paper" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0">
                    <PathIcon Data="{StaticResource IconDocument}" Width="72" Height="72" Foreground="{DynamicResource Brand300}" />
                </Border>
                <PathIcon Data="{StaticResource IconPrint}" Width="200" Height="200" Foreground="{DynamicResource Brand500}"
                          VerticalAlignment="Bottom" Margin="0,0,0,24" />
            </Panel>
        </Grid>

        <!-- The ways a file comes in, in the poster's order: USB, phone, print code. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource Space6}"
              IsVisible="{Binding CanPrintFromFlash}">
            <Button Grid.Column="0" Classes="source" Command="{Binding PrintFromUsbCommand}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource Space2}">
                    <Border Classes="icon-tile">
                        <PathIcon Data="{StaticResource IconUsb}" Width="40" Height="40" Foreground="{DynamicResource Brand500}" />
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding UsbCardTitle}" Classes="h2" TextWrapping="Wrap" Margin="{DynamicResource GapAbove2}" />
                    <TextBlock Grid.Row="2" Text="{Binding UsbCardHint}" Classes="muted" FontWeight="Normal" TextWrapping="Wrap" />
                    <PathIcon Grid.Row="3" Data="{StaticResource IconArrowForward}" Width="32" Height="32"
                              HorizontalAlignment="Right" Foreground="{DynamicResource Brand500}" />
                </Grid>
            </Button>

            <!-- Done on the phone, so a card and not a button: the scanner reads it. -->
            <Border Grid.Column="1" Classes="source-info">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Space2}">
                    <Border Classes="icon-tile">
                        <PathIcon Data="{StaticResource IconPhone}" Width="40" Height="40" Foreground="{DynamicResource Brand500}" />
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding PhoneCardTitle}" Classes="h2" TextWrapping="Wrap" Margin="{DynamicResource GapAbove2}" />
                    <TextBlock Grid.Row="2" Text="{Binding PhoneCardHint}" Classes="muted" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- The app's "Çap kodu" (T-345): the personal QR as six digits. -->
            <Button Grid.Column="2" Classes="source" Command="{Binding PrintByCodeCommand}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{DynamicResource Space2}">
                    <Border Classes="icon-tile">
                        <PathIcon Data="{StaticResource IconQrCode}" Width="40" Height="40" Foreground="{DynamicResource Brand500}" />
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding CodeCardTitle}" Classes="h2" TextWrapping="Wrap" Margin="{DynamicResource GapAbove2}" />
                    <TextBlock Grid.Row="2" Text="{Binding CodeCardHint}" Classes="muted" FontWeight="Normal" TextWrapping="Wrap" />
                    <PathIcon Grid.Row="3" Data="{StaticResource IconArrowForward}" Width="32" Height="32"
                              HorizontalAlignment="Right" Foreground="{DynamicResource Brand500}" />
                </Grid>
            </Button>
        </Grid>

        <!-- Cancelling by code: quiet words under the cards, not a fourth card. -->
        <Button Grid.Row="3" Classes="back" HorizontalAlignment="Left" Command="{Binding CancelByCodeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                <PathIcon Data="{StaticResource IconInfo}" Width="28" Height="28" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CancelByCodeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- What the kiosk offers, along the bottom (the poster's strip). -->
        <Border Grid.Row="5" Classes="card" IsVisible="{Binding !HasRefundNotice}">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource Space6}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
                    <Border Classes="icon-tile small"><PathIcon Data="{StaticResource IconDocument}" Width="28" Height="28" Foreground="{DynamicResource Brand500}" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FeatureSizesTitle}" Classes="body-small" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FeatureSizesHint}" Classes="caption" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
                    <Border Classes="icon-tile small"><PathIcon Data="{StaticResource IconContrast}" Width="28" Height="28" Foreground="{DynamicResource Brand500}" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FeatureColorTitle}" Classes="body-small" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FeatureColorHint}" Classes="caption" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
                    <Border Classes="icon-tile small"><PathIcon Data="{StaticResource IconBolt}" Width="28" Height="28" Foreground="{DynamicResource Brand500}" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FeatureFastTitle}" Classes="body-small" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FeatureFastHint}" Classes="caption" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="3" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space4}">
                    <Border Classes="icon-tile small"><PathIcon Data="{StaticResource IconShield}" Width="28" Height="28" Foreground="{DynamicResource Brand500}" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FeatureSafeTitle}" Classes="body-small" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FeatureSafeHint}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
