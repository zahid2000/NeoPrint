<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
             x:Class="NeoPrint.Kiosk.Views.OfflineView"
             x:DataType="vm:MainWindowViewModel">

    <!-- Screen 16 (plan section 7.3): no connection, or the cached configuration
         has gone stale, so no new order can be
         taken. The kiosk resumes on its own when the link returns. -->

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="620">
        <TextBlock Text="{Binding OfflineTitle}" FontSize="40" FontWeight="Bold"
                   Foreground="#F8FAFC" HorizontalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding OfflineBody}" FontSize="19"
                   Foreground="#94A3B8" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
