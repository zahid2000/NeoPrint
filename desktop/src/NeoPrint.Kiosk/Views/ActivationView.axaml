<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
             x:Class="NeoPrint.Kiosk.Views.ActivationView"
             x:DataType="vm:ActivationViewModel">

    <!--
        Screen 0 (plan section 7.3): a brand-new kiosk showing its pairing code,
        the QR an operator can scan, the countdown to the code refreshing, what
        machine this is, and whether the backend is reachable.
    -->

    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

        <StackPanel Grid.Column="0" Spacing="24" MaxWidth="760">
            <TextBlock Text="{Binding Title}"
                       Classes="h1"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding Instruction}"
                       Classes="muted"
                       TextWrapping="Wrap" />

            <!-- The code is what someone reads out over the phone, so it is the
                 largest element on the screen. -->
            <Border Background="{DynamicResource Brand50}"
                    BorderBrush="{DynamicResource Brand300}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Padding="40,28"
                    HorizontalAlignment="Left">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding DisplayCode}"
                               FontSize="72" FontWeight="SemiBold"
                               FontFamily="monospace"
                               Foreground="{DynamicResource Brand700}" />
                    <TextBlock Text="{Binding CodeExpiryText}"
                               Classes="caption" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                         Fill="{Binding IsBackendReachable, Converter={x:Static vm:ScreenConverters.PrintingBrush}}" />
                <TextBlock Text="{Binding ConnectionStatus}"
                           Classes="caption"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Classes="card" HorizontalAlignment="Left">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding DeviceInfoHeading}"
                               Classes="body-small"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Neutral900}"
                               Margin="0,0,0,4" />

                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding HostnameLabel}"
                                   Classes="caption" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hostname}"
                                   Classes="caption"
                                   Foreground="{DynamicResource Neutral800}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PlatformLabel}"
                                   Classes="caption" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Platform}"
                                   Classes="caption"
                                   Foreground="{DynamicResource Neutral800}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding VersionLabel}"
                                   Classes="caption" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Version}"
                                   Classes="caption"
                                   Foreground="{DynamicResource Neutral800}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding PrintersHeading}"
                                   Classes="caption" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PrintersSummary}"
                                   Classes="caption"
                                   Foreground="{DynamicResource Neutral800}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- The activation QR takes the place of the kiosk QR while the kiosk
             has no code of its own yet (plan sections 2.9, 7.3). -->
        <Border Grid.Column="1" Background="White"
                BorderBrush="{DynamicResource Neutral200}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusLg}"
                Padding="24"
                VerticalAlignment="Center" Margin="48,0,0,0"
                IsVisible="{Binding ActivationQr, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Image Source="{Binding ActivationQr, Converter={x:Static vm:ScreenConverters.QrImage}}"
                   Width="280" Height="280" />
        </Border>
    </Grid>
</UserControl>
