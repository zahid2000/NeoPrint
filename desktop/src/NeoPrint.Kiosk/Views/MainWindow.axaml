<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
        xmlns:views="using:NeoPrint.Kiosk.Views"
        mc:Ignorable="d"
        d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="NeoPrint.Kiosk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NeoPrint"
        WindowState="FullScreen"
        SystemDecorations="None"
        Topmost="True"
        Background="{DynamicResource Neutral50}">

    <!--
        The shell from plan section 7.2. Header, footer and queue panel live
        here, and only the central area changes, so the kiosk QR and code stay
        visible on every screen and a dialog cannot cover the footer.

        Every colour, size and spacing comes from Styles/Tokens.axaml
        (docs/DESIGN_SYSTEM.md section 8).
    -->

    <!-- Every screen is laid out for 1920x1080. A smaller screen, or Windows
         scaling (125 % makes a 1080p screen 1536x864), would cut off whatever
         does not fit - the bottom rows of a keypad (T-097). The whole surface
         is scaled instead, so nothing is ever cut and nothing needs scrolling.
         A 4:3 or 5:4 screen gets a 1600-wide surface of its own shape instead
         (MainWindow.SurfaceFor, T-329). -->
    <Viewbox Stretch="Uniform">
    <!-- The poster's surface (T-371): a soft blue light from the top over white. -->
    <Grid x:Name="Surface" RowDefinitions="104,*,96"
          Width="{StaticResource DesignWidth}" Height="{StaticResource DesignHeight}">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{StaticResource Brand50Color}" Offset="0" />
                <GradientStop Color="{StaticResource Neutral0Color}" Offset="0.7" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- HEADER (T-371, as the poster draws it): the mark and the name on the left;
             the language as "AZ ▾" and the clock with the date on the right. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="{DynamicResource InsetX8}">

            <!-- The logo is also the hidden admin corner: five taps in three
                 seconds (plan section 7.12). Nothing on it shows it. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Space4}"
                        VerticalAlignment="Center" Background="Transparent"
                        PointerPressed="OnLogoPressed">
                <Border Width="52" Height="52"
                        Background="{DynamicResource Brand500}"
                        CornerRadius="{DynamicResource RadiusSm}">
                    <PathIcon Data="{StaticResource IconPrint}"
                              Width="28" Height="28"
                              Foreground="{DynamicResource Neutral0}" />
                </Border>
                <TextBlock Text="NeoPrint" Classes="h1" FontWeight="Bold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Spacing="{DynamicResource Space4}"
                        Margin="{DynamicResource GapStart8}"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding KioskName}"
                           Classes="muted"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- A phone joined in a session (plan section 9.3): that one did,
                     never who - the screen is in a public place. Not a button. -->
                <Border IsVisible="{Binding HasConnectedPhones}"
                        Background="{DynamicResource InfoBg}"
                        CornerRadius="{DynamicResource RadiusSm}"
                        Height="{DynamicResource StatusChipHeight}"
                        Padding="{DynamicResource InsetX4}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <PathIcon Data="{StaticResource IconPhone}"
                                  Width="20" Height="20"
                                  Foreground="{DynamicResource Info500}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectedPhonesText}"
                                   Foreground="{DynamicResource Neutral900}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- "AZ ▾": the three languages come out beside it, large targets (touch). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Space4}"
                        VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Languages}" IsVisible="{Binding IsLanguageOpen}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MainWindowViewModel+LanguageOption">
                            <Button Content="{Binding Name}"
                                    Classes="choice"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectLanguageCommand}"
                                    CommandParameter="{Binding Code}"
                                    MinWidth="120"
                                    MinHeight="{DynamicResource TouchTarget}"
                                    Padding="{DynamicResource InsetX4}"
                                    FontSize="{DynamicResource FontSizeBodySmall}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="lang" Command="{Binding ToggleLanguagesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                        <PathIcon Data="{StaticResource IconLanguage}" Width="24" Height="24" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LanguageShort}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <PathIcon Data="{StaticResource IconChevronDown}" Width="24" Height="24" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="{DynamicResource GapStart8}" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClockText}" Classes="h2" FontWeight="Bold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DateText}" Classes="caption" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- CENTRAL AREA: the only part that changes between screens -->
        <Panel Grid.Row="1" Margin="{DynamicResource PagePadding}">
            <!-- Each screen sits inside a host whose visibility is bound to the
                 shell. The activation screen has its own view model, so the
                 wrapper keeps that DataContext change from also reaching the
                 IsVisible binding. -->
            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsActivation}}">
                <views:ActivationView DataContext="{Binding Activation}" />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsStarting}}">
                <views:StartingView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsNotConfigured}}">
                <views:NotConfiguredView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsDegraded}}">
                <views:DegradedView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsOffline}}">
                <views:OfflineView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsHome}}">
                <views:HomeView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsFlow}}">
                <views:FlowView DataContext="{Binding Flow}" />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsOutOfService}}">
                <views:OutOfServiceView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsSafeMode}}">
                <views:SafeModeView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsAdmin}}">
                <views:AdminView DataContext="{Binding Admin}" />
            </Panel>

            <!-- Over whatever is under it: the kiosk is about to be updated (T-321). -->
            <Panel IsVisible="{Binding ShowUpdating}">
                <views:UpdatingView />
            </Panel>
        </Panel>

        <!-- "Çap növbəsi" (T-371, the poster's screen 11): opened from the footer, over
             whatever is under it; "Geri" or a minute without a touch closes it. -->
        <Panel Grid.Row="1" IsVisible="{Binding IsQueueOpen}" Margin="{DynamicResource PagePadding}">
            <Border Classes="card" Background="{DynamicResource Neutral0}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Classes="back" Command="{Binding CloseQueueCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <PathIcon Data="{StaticResource IconArrowBack}" Width="24" Height="24" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BackText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding QueueScreenTitle}" Classes="h1"
                                   Margin="{DynamicResource GapStart6}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding QueueScreenHint}" Classes="muted" Margin="{DynamicResource GapAbove2}" />

                    <Panel Grid.Row="2" Margin="{DynamicResource GapAbove6}">
                        <TextBlock Text="{Binding QueueEmptyText}" Classes="h2" Foreground="{DynamicResource Neutral600}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !Queue.Count}" />
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Queue}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QueueEntry">
                                        <!-- One row: the place, the code, the pages, the status, when it is ready;
                                             the one on the printer with its page and bar (T-360). -->
                                        <Border Classes="queue-row" Classes.printing="{Binding IsPrinting}">
                                            <Grid ColumnDefinitions="96,*,*,Auto,200" ColumnSpacing="{DynamicResource Space6}">
                                                <TextBlock Text="{Binding Position, StringFormat=#{0}}" Classes="h2" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brand500}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding JobCode}" Classes="h2"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="{DynamicResource Space2}">
                                                    <TextBlock Text="{Binding PagesText}" />
                                                    <StackPanel IsVisible="{Binding ShowProgress}" Spacing="{DynamicResource Space2}">
                                                        <TextBlock Text="{Binding ProgressText}" Classes="body-small" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brand600}" />
                                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                                                     Height="{StaticResource QueueProgressHeight}" MinHeight="{StaticResource QueueProgressHeight}" MinWidth="0"
                                                                     Foreground="{DynamicResource Brand600}" Background="{DynamicResource Neutral100}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="3" Classes="status-chip" Classes.ok="{Binding IsPrinting}" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                                        <!-- T-360: the hourglass turns while the job is on the printer. -->
                                                        <PathIcon Classes="busy" Width="20" Height="20" VerticalAlignment="Center"
                                                                  Data="{StaticResource IconHourglass}" IsVisible="{Binding IsPrinting}"
                                                                  Foreground="{DynamicResource Success500}" />
                                                        <PathIcon Width="20" Height="20" VerticalAlignment="Center"
                                                                  Data="{StaticResource IconClock}" IsVisible="{Binding !IsPrinting}"
                                                                  Foreground="{DynamicResource Warning500}" />
                                                        <TextBlock Text="{Binding StatusText}" Classes="body-small" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="4" Text="{Binding FinishText}" Classes="body-small"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </Grid>
            </Border>
        </Panel>

        <!-- FOOTER (T-371): the kiosk QR and code on the left; on the right the printer as
             colour, icon and words, and "Növbə: N", which opens the queue. -->
        <Border Grid.Row="2"
                Background="{DynamicResource Neutral0}"
                BorderBrush="{DynamicResource Neutral200}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Space4}" Margin="{DynamicResource InsetX8}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Space4}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowKioskQr}">
                    <!-- The QR sits on white whatever is behind it: a scanner
                         needs the quiet zone and the contrast. -->
                    <Border Background="{DynamicResource QrBackground}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="{DynamicResource QrQuietZone}">
                        <Image Source="{Binding KioskQr, Converter={x:Static vm:ScreenConverters.QrImage}}"
                               Width="56" Height="56" />
                    </Border>
                    <TextBlock Text="{Binding KioskCode}"
                               Classes="body-small"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Neutral900}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Hotline}"
                               Classes="caption"
                               Margin="{DynamicResource GapStart6}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Classes="status-chip" Classes.ok="{Binding PrinterOk}" Classes.problem="{Binding !PrinterOk}"
                        VerticalAlignment="Center" IsVisible="{Binding ShowKioskQr}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                        <PathIcon Data="{StaticResource IconSuccess}" Width="24" Height="24" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Success500}" IsVisible="{Binding PrinterOk}" />
                        <PathIcon Data="{StaticResource IconWarning}" Width="24" Height="24" VerticalAlignment="Center"
                                  Foreground="{DynamicResource Warning500}" IsVisible="{Binding !PrinterOk}" />
                        <TextBlock Text="{Binding PrinterStatusText}" Classes="body-small" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="3" Classes="queue-chip" Command="{Binding OpenQueueCommand}"
                        VerticalAlignment="Center" IsVisible="{Binding ShowKioskQr}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                        <PathIcon Data="{StaticResource IconQueue}" Width="24" Height="24" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding QueueButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- "Sessiya bitmək üzrədir" (T-341, the poster's screen 15): over the whole
             surface, so nothing under it can be touched by mistake; any touch keeps
             the order, "Ləğv et" drops it now, zero drops it as the idle reset did. -->
        <Panel Grid.RowSpan="3" IsVisible="{Binding ShowIdleWarning}">
            <Border Background="{DynamicResource Neutral900}" Opacity="{StaticResource ScrimOpacity}" />
            <Border Classes="card" Width="{StaticResource DialogWidth}" CornerRadius="{DynamicResource RadiusLg}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="{DynamicResource Space6}">
                    <Border Width="{DynamicResource StatusIconSize}" Height="{DynamicResource StatusIconSize}" Background="{DynamicResource WarningBg}"
                            CornerRadius="{DynamicResource StatusIconRadius}" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconClock}" Width="60" Height="60" Foreground="{DynamicResource Warning500}" />
                    </Border>
                    <TextBlock Text="{Binding IdleWarningTitle}" Classes="h1" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IdleWarningBody}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IdleCountdownText}" Classes="display" HorizontalAlignment="Center" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding IdleWarningProgress}" Height="{StaticResource CountdownBarHeight}"
                                 Foreground="{DynamicResource Brand600}" Background="{DynamicResource Neutral100}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Space4}">
                        <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding EndSessionCommand}">
                            <TextBlock Text="{Binding IdleEndText}" />
                        </Button>
                        <Button Grid.Column="1" Classes="primary" HorizontalAlignment="Stretch" Command="{Binding StayInSessionCommand}">
                            <TextBlock Text="{Binding IdleStayText}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
    </Viewbox>
</Window>
