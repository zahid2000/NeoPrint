<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
        xmlns:views="using:NeoPrint.Kiosk.Views"
        mc:Ignorable="d"
        d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="NeoPrint.Kiosk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NeoPrint"
        WindowState="FullScreen"
        SystemDecorations="None"
        Topmost="True"
        Background="{DynamicResource Neutral50}">

    <!--
        The shell from plan section 7.2. Header, footer and queue panel live
        here, and only the central area changes, so the kiosk QR and code stay
        visible on every screen and a dialog cannot cover the footer.

        Every colour, size and spacing comes from Styles/Tokens.axaml
        (docs/DESIGN_SYSTEM.md section 8).
    -->

    <!-- Every screen is laid out for 1920x1080. A smaller screen, or Windows
         scaling (125 % makes a 1080p screen 1536x864), would cut off whatever
         does not fit - the bottom rows of a keypad (T-097). The whole surface
         is scaled instead, so nothing is ever cut and nothing needs scrolling.
         A 4:3 or 5:4 screen gets a 1600-wide surface of its own shape instead
         (MainWindow.SurfaceFor, T-329). -->
    <Viewbox Stretch="Uniform">
    <Grid x:Name="Surface" RowDefinitions="88,*,96" ColumnDefinitions="*,280"
          Width="{StaticResource DesignWidth}" Height="{StaticResource DesignHeight}">

        <!-- HEADER: logo, kiosk name, language, clock -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource Neutral0}"
                BorderBrush="{DynamicResource Neutral200}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{DynamicResource InsetX8}">

                <!-- The logo is also the hidden admin corner: five taps in three
                     seconds (plan section 7.12). Nothing on it shows it. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Space4}"
                            VerticalAlignment="Center" Background="Transparent"
                            PointerPressed="OnLogoPressed">
                    <Border Width="44" Height="44"
                            Background="{DynamicResource Brand600}"
                            CornerRadius="{DynamicResource RadiusSm}">
                        <PathIcon Data="{StaticResource IconPrint}"
                                  Width="24" Height="24"
                                  Foreground="{DynamicResource Neutral0}" />
                    </Border>

                    <TextBlock Text="NeoPrint" Classes="h2"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Spacing="{DynamicResource Space4}"
                            Margin="{DynamicResource GapStart6}"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding KioskName}"
                               Classes="muted"
                               VerticalAlignment="Center" />

                    <!-- A phone joined in a session (plan section 9.3): that one did,
                         never who - the screen is in a public place. Not a button. -->
                    <Border IsVisible="{Binding HasConnectedPhones}"
                            Background="{DynamicResource InfoBg}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Height="{DynamicResource StatusChipHeight}"
                            Padding="{DynamicResource InsetX4}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                            <PathIcon Data="{StaticResource IconPhone}"
                                      Width="20" Height="20"
                                      Foreground="{DynamicResource Info500}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectedPhonesText}"
                                       Foreground="{DynamicResource Neutral900}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Language picker: large targets, this is a touch screen. -->
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Languages}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MainWindowViewModel+LanguageOption">
                            <Button Content="{Binding Name}"
                                    Classes="choice"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectLanguageCommand}"
                                    CommandParameter="{Binding Code}"
                                    MinWidth="120"
                                    MinHeight="{DynamicResource TouchTarget}"
                                    Padding="{DynamicResource InsetX4}"
                                    FontSize="{DynamicResource FontSizeBodySmall}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="3"
                           Text="{Binding ClockText}"
                           Classes="h2"
                           Margin="{DynamicResource GapStart8}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- CENTRAL AREA: the only part that changes between screens -->
        <Panel Grid.Row="1" Grid.Column="0" Margin="{DynamicResource PagePadding}">
            <!-- Each screen sits inside a host whose visibility is bound to the
                 shell. The activation screen has its own view model, so the
                 wrapper keeps that DataContext change from also reaching the
                 IsVisible binding. -->
            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsActivation}}">
                <views:ActivationView DataContext="{Binding Activation}" />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsStarting}}">
                <views:StartingView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsNotConfigured}}">
                <views:NotConfiguredView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsDegraded}}">
                <views:DegradedView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsOffline}}">
                <views:OfflineView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsHome}}">
                <views:HomeView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsFlow}}">
                <views:FlowView DataContext="{Binding Flow}" />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsOutOfService}}">
                <views:OutOfServiceView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsSafeMode}}">
                <views:SafeModeView />
            </Panel>

            <Panel IsVisible="{Binding Screen, Converter={x:Static vm:ScreenConverters.IsAdmin}}">
                <views:AdminView DataContext="{Binding Admin}" />
            </Panel>

            <!-- Over whatever is under it: the kiosk is about to be updated (T-321). -->
            <Panel IsVisible="{Binding ShowUpdating}">
                <views:UpdatingView />
            </Panel>
        </Panel>

        <!-- QUEUE PANEL: 280px on the right, present on every screen -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{DynamicResource Neutral0}"
                BorderBrush="{DynamicResource Neutral200}"
                BorderThickness="1,0,0,0">
            <StackPanel Margin="{DynamicResource Inset6}">
                <TextBlock Text="{Binding QueueTitle}"
                           Classes="h2"
                           Margin="{DynamicResource GapBelow4}" />

                <TextBlock Text="{Binding QueueEmptyText}"
                           Classes="caption"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !Queue.Count}" />

                <ItemsControl ItemsSource="{Binding Queue}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueueEntry">
                            <Border Background="{DynamicResource Neutral50}"
                                    BorderBrush="{DynamicResource Neutral200}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSm}"
                                    Padding="{DynamicResource Inset4}" Margin="{DynamicResource GapBelow4}">
                                <!-- One column under the position: code, pages, status - side by side
                                     they do not fit 280px and run into each other (T-122). -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Position, StringFormat=#{0}}"
                                               Classes="body-small"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brand600}"
                                               VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Margin="{DynamicResource GapStart4}">
                                        <TextBlock Text="{Binding JobCode}"
                                                   Classes="body-small"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Neutral900}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PagesText}"
                                                   Classes="caption"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                                            <PathIcon Width="20" Height="20" VerticalAlignment="Center"
                                                      Data="{StaticResource IconPrint}" IsVisible="{Binding IsPrinting}"
                                                      Foreground="{Binding IsPrinting, Converter={x:Static vm:ScreenConverters.PrintingBrush}}" />
                                            <PathIcon Width="20" Height="20" VerticalAlignment="Center"
                                                      Data="{StaticResource IconClock}" IsVisible="{Binding !IsPrinting}"
                                                      Foreground="{Binding IsPrinting, Converter={x:Static vm:ScreenConverters.PrintingBrush}}" />
                                            <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- FOOTER: kiosk QR on the left with the code beside it, help on the right -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{DynamicResource Neutral0}"
                BorderBrush="{DynamicResource Neutral200}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{DynamicResource InsetX8}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Space4}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowKioskQr}">
                    <!-- The QR sits on white whatever is behind it: a scanner
                         needs the quiet zone and the contrast. -->
                    <Border Background="{DynamicResource QrBackground}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="{DynamicResource QrQuietZone}">
                        <Image Source="{Binding KioskQr, Converter={x:Static vm:ScreenConverters.QrImage}}"
                               Width="56" Height="56" />
                    </Border>
                    <TextBlock Text="{Binding KioskCode}"
                               Classes="body-small"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Neutral900}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding Hotline}"
                           Classes="caption"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
    </Viewbox>
</Window>
