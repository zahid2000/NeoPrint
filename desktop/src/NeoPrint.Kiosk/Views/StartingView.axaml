<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
             x:Class="NeoPrint.Kiosk.Views.StartingView"
             x:DataType="vm:MainWindowViewModel">

    <!-- Shown for the moment between the process starting and the kiosk
         knowing what it is (plan section 7.12, recovery flow). -->

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="32">
        <Border Width="96" Height="96"
                Background="{DynamicResource Brand600}"
                CornerRadius="{DynamicResource RadiusLg}"
                HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource IconPrint}"
                      Width="52" Height="52"
                      Foreground="{DynamicResource Neutral0}" />
        </Border>

        <TextBlock Text="NeoPrint" Classes="display" HorizontalAlignment="Center" />

        <TextBlock Text="{Binding StartingText}" Classes="muted"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
