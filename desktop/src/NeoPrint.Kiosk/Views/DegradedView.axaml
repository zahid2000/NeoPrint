<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NeoPrint.Kiosk.ViewModels"
             x:Class="NeoPrint.Kiosk.Views.DegradedView"
             x:DataType="vm:MainWindowViewModel">

    <!-- Screen 15 (plan section 7.3): the backend cannot be reached but the
         cached configuration is still fresh. Work already paid for keeps
         printing, so the queue panel stays as it is; what stops is taking a
         new payment, because a payment the backend has not confirmed must
         never be shown as successful (docs/OFFLINE_BEHAVIOR.md). -->

    <!-- A stopped kiosk says so with a large icon as well as the text: from
         standing distance the icon is what is read first
         (docs/DESIGN_SYSTEM.md section 5.1). -->

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                Spacing="{DynamicResource Space6}" MaxWidth="720">
        <Border Width="120" Height="120"
                Background="{DynamicResource WarningBg}"
                CornerRadius="60"
                HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource IconWarning}"
                      Width="60" Height="60"
                      Foreground="{DynamicResource Warning500}" />
        </Border>

        <TextBlock Text="{Binding DegradedTitle}" Classes="h1"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" />

        <TextBlock Text="{Binding DegradedBody}" Classes="muted"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
