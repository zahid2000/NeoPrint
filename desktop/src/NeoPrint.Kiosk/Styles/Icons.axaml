<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The icons the kiosk screens use, as path data.

        Material Symbols outlines (Apache-2.0), the family the design system
        names (section 3), drawn as geometry rather than loaded from an icon
        font: the kiosk runs on a locked-down machine where installing a font
        is one more thing the provisioning script has to get right, and these
        few shapes do not justify it. Every path is on the same 24x24 grid, so
        they scale together.
    -->

