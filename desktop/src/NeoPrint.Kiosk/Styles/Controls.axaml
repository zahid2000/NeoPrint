<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The kiosk's control defaults, built from Tokens.axaml.

        Every screen gets these without asking, which is what keeps a button
        added later the same size as the ones already there. A view that needs
        something different sets a class, not a literal
        (docs/DESIGN_SYSTEM.md section 8).
    -->

    <!-- Buttons: a finger, not a mouse. Minimum 72 tall, 64 wide. -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{DynamicResource ButtonHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource TouchTarget}" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeButton}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Neutral100}" />
        <Setter Property="Foreground" Value="{DynamicResource Neutral900}" />
    </Style>

    <!-- The one primary action on a screen. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Brand600}" />
        <Setter Property="Foreground" Value="{DynamicResource Neutral0}" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand700}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Neutral0}" />
    </Style>

    <!-- Secondary: outlined, so the primary stays the only filled one. -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Neutral0}" />
        <Setter Property="Foreground" Value="{DynamicResource Neutral900}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Neutral200}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- A destructive action's confirmation: cancelling an order. -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource Danger500}" />
        <Setter Property="Foreground" Value="{DynamicResource Neutral0}" />
    </Style>

    <!-- One of several choices (colour, sides, paper): outlined, filled when chosen. -->
    <Style Selector="Button.choice">
        <Setter Property="Background" Value="{DynamicResource Neutral0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Neutral200}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.choice.selected">
        <Setter Property="Background" Value="{DynamicResource Brand50}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand600}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand700}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A choice fixed for the customer (a scan at real size): still shown as the one chosen,
         not greyed like the others (docs/DESIGN_SYSTEM.md, "Real ölçü kilidi"). -->
    <Style Selector="Button.choice.selected:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brand50}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand600}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand700}" />
    </Style>

    <!-- A way to pay (section 4, "Ödəniş ekranları"): a whole card is the button. -->
    <Style Selector="Button.pay-method">
        <Setter Property="Background" Value="{DynamicResource Neutral0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Neutral200}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource PayMethodMinHeight}" />
        <Setter Property="Width" Value="{DynamicResource PayMethodWidth}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <!-- Side by side the cards are one height, their content starting at the top: a title that
             wraps in one language must not leave its card taller and lower than its neighbour. -->
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style Selector="Button.pay-method:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brand600}" />
        <Setter Property="Background" Value="{DynamicResource Brand50}" />
    </Style>

    <!-- Information the customer should know, not a problem: why an option is fixed. -->
    <Style Selector="Border.info">
        <Setter Property="Background" Value="{DynamicResource InfoBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Info500}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="{DynamicResource Inset4}" />
    </Style>

    <!-- A warning the customer must see before paying: a code that did not apply. -->
    <Style Selector="Border.warning">
        <Setter Property="Background" Value="{DynamicResource WarningBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Warning500}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="{DynamicResource Inset4}" />
    </Style>

    <!-- A QR to scan: white with a quiet zone whatever is around it. -->
    <Style Selector="Border.qr">
        <Setter Property="Background" Value="{DynamicResource QrBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Neutral200}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="Padding" Value="{DynamicResource Inset6}" />
    </Style>

    <!-- A key of the on-screen keyboard: square, a finger's width. -->
    <Style Selector="Button.key">
        <Setter Property="MinWidth" Value="{DynamicResource TouchTarget}" />
        <Setter Property="Margin" Value="{DynamicResource KeyGap}" />
        <Setter Property="Padding" Value="{DynamicResource Inset4}" />
        <Setter Property="Background" Value="{DynamicResource Neutral0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Neutral200}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- A key whose glyph is smaller than a digit ("," "-"): no padding, so the
         key stays as tall as the others with its glyph at display size (the
         glyph's own style is at the end of the file). -->
    <Style Selector="Button.key.symbol">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The step indicator of a flash order (section 4): a numbered circle and a name. -->
    <Style Selector="Border.step">
        <Setter Property="Width" Value="{DynamicResource StatusChipHeight}" />
        <Setter Property="Height" Value="{DynamicResource StatusChipHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
        <Setter Property="Background" Value="{DynamicResource Neutral100}" />
    </Style>

    <Style Selector="Border.step.current">
        <Setter Property="Background" Value="{DynamicResource Brand600}" />
    </Style>

    <Style Selector="TextBlock.step-number">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Neutral600}" />
    </Style>

    <Style Selector="TextBlock.step-number.current">
        <Setter Property="Foreground" Value="{DynamicResource Neutral0}" />
    </Style>

    <Style Selector="TextBlock.step-label">
        <Setter Property="Foreground" Value="{DynamicResource Neutral600}" />
    </Style>

    <Style Selector="TextBlock.step-label.current">
        <Setter Property="Foreground" Value="{DynamicResource Brand700}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- An error: what happened, what it means, what to do (section 4). -->
    <Style Selector="Border.error">
        <Setter Property="Background" Value="{DynamicResource DangerBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Danger500}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="{DynamicResource Inset4}" />
    </Style>

    <!-- The "USB" badge on every screen of a flash order (plan section 7.3). -->
    <Style Selector="Border.usb">
        <Setter Property="Background" Value="{DynamicResource InfoBg}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Padding" Value="{DynamicResource InsetX4}" />
    </Style>

    <!-- Text, at the design system's kiosk sizes. -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Neutral800}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="TextBlock.display">
        <Setter Property="Foreground" Value="{DynamicResource Neutral900}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="Foreground" Value="{DynamicResource Neutral900}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="Foreground" Value="{DynamicResource Neutral900}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.body-small">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySmall}" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="Foreground" Value="{DynamicResource Neutral600}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Neutral600}" />
    </Style>

    <!-- A card, as the design system defines one: section 4. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Neutral0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Neutral200}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
    </Style>

    <!-- A card that cannot be chosen here: grey, and its own line says why (docs/DESIGN_SYSTEM.md §5.1). -->
    <Style Selector="Border.card.off">
        <Setter Property="Background" Value="{DynamicResource Neutral100}" />
    </Style>

    <!-- The text of a filled button is always white. Last in the file on purpose:
         Avalonia applies styles in order, not by specificity, so the TextBlock
         style above would otherwise paint it Neutral800 on the brand or danger
         fill, as it did on the admin screens (docs/TASKS.md T-082). -->
    <Style Selector="Button.primary TextBlock, Button.danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Neutral0}" />
    </Style>

    <!-- "," and "-" on a keypad: at digit size they are a speck (T-097). After
         the global TextBlock style for the same reason as above. -->
    <Style Selector="Button.key.symbol TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- The last minute of a payment countdown: warning colour, with its icon beside it. After
         the global TextBlock style for the same reason as above. -->
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="{DynamicResource Warning500}" />
    </Style>
</Styles>
