<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The kiosk UI (plan section 7). One build per operating system
    (win-x64, linux-x64) runs on every kiosk: no per-kiosk build, no per-kiosk
    configuration file, no credentials in the package (plan section 7.11).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      net8.0-windows on Windows, plain net8.0 on Linux. A net8.0 assembly
      cannot reference a net8.0-windows one, so the framework follows the
      platform the package is for; the shared projects stay net8.0
      (plan section 7.6).
    -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' != 'linux-x64'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <RootNamespace>NeoPrint.Kiosk</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Which platform assembly this package carries, decided by the runtime
    identifier so a Linux package never contains the Windows-only assembly and
    vice versa (plan section 7.6). Program.cs switches on the same symbols, and
    DI then picks the implementation at runtime.
  -->
  <PropertyGroup>
    <NeoPrintTargetsWindows Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</NeoPrintTargetsWindows>
    <NeoPrintTargetsWindows Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">true</NeoPrintTargetsWindows>
    <NeoPrintTargetsLinux Condition="'$(RuntimeIdentifier)' == 'linux-x64'">true</NeoPrintTargetsLinux>
    <NeoPrintTargetsLinux Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">true</NeoPrintTargetsLinux>

    <DefineConstants Condition="'$(NeoPrintTargetsWindows)' == 'true'">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(NeoPrintTargetsLinux)' == 'true'">$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Diagnostics" />
  </ItemGroup>

  <!--
    The settings files have to sit next to the executable: a console or desktop
    project does not copy them the way the Web SDK does, so without this the
    application starts with its compiled-in defaults and its own appsettings.json
    is never read.
  -->
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoPrint.Kiosk.Core\NeoPrint.Kiosk.Core.csproj" />
    <ProjectReference Include="..\NeoPrint.Kiosk.Printing\NeoPrint.Kiosk.Printing.csproj" />
  </ItemGroup>

  <!--
    So the composition root itself can be tested: which services are shared and
    which are not is behaviour, not a detail (the API client holds the device
    identity, so there has to be exactly one).
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NeoPrint.Kiosk.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(NeoPrintTargetsWindows)' == 'true'">
    <ProjectReference Include="..\NeoPrint.Kiosk.Platform.Windows\NeoPrint.Kiosk.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(NeoPrintTargetsLinux)' == 'true'">
    <ProjectReference Include="..\NeoPrint.Kiosk.Platform.Linux\NeoPrint.Kiosk.Platform.Linux.csproj" />
  </ItemGroup>

  <!--
    PDFium ships inside the build (T-096). The preview and the page count of
    every converted file need it; without it every page was blank and only a
    PDF opened. The same pinned release as the backend image (docs/THIRD_PARTY.md),
    checked against its SHA-256 before anything is unpacked (T-100), cached in
    obj/ so only the first build downloads it.
  -->
  <PropertyGroup>
    <PdfiumRelease>chromium/8066</PdfiumRelease>
    <PdfiumPackage Condition="'$(NeoPrintTargetsWindows)' == 'true'">pdfium-win-x64</PdfiumPackage>
    <PdfiumSha256 Condition="'$(NeoPrintTargetsWindows)' == 'true'">739a57d597d864297909cc40a2411eba728490c76a0fa25e3ea299c7f6b07020</PdfiumSha256>
    <PdfiumLibrary Condition="'$(NeoPrintTargetsWindows)' == 'true'">bin\pdfium.dll</PdfiumLibrary>
    <PdfiumPackage Condition="'$(NeoPrintTargetsLinux)' == 'true'">pdfium-linux-x64</PdfiumPackage>
    <PdfiumSha256 Condition="'$(NeoPrintTargetsLinux)' == 'true'">0b43f405477cf2cfc4dbff06905093c3309756c6bca1fb9da99234a2ca97fed2</PdfiumSha256>
    <PdfiumLibrary Condition="'$(NeoPrintTargetsLinux)' == 'true'">lib\libpdfium.so</PdfiumLibrary>
    <PdfiumCache>$(MSBuildProjectDirectory)\obj\pdfium\$(PdfiumPackage)\</PdfiumCache>
  </PropertyGroup>

  <ItemGroup Condition="'$(PdfiumPackage)' != ''">
    <None Include="$(PdfiumCache)$(PdfiumLibrary)" Link="$([System.IO.Path]::GetFileName('$(PdfiumLibrary)'))"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PdfiumCache)LICENSE" Link="pdfium-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="FetchPdfium" BeforeTargets="BeforeBuild"
          Condition="'$(PdfiumPackage)' != '' And !Exists('$(PdfiumCache)$(PdfiumLibrary)')">
    <DownloadFile SourceUrl="https://github.com/bblanchon/pdfium-binaries/releases/download/$(PdfiumRelease)/$(PdfiumPackage).tgz"
                  DestinationFolder="$(PdfiumCache)" Retries="3" />
    <GetFileHash Files="$(PdfiumCache)$(PdfiumPackage).tgz" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_PdfiumActualSha256" />
    </GetFileHash>
    <!-- MSBuild compares strings case-insensitively; GetFileHash answers in upper case. -->
    <Delete Files="$(PdfiumCache)$(PdfiumPackage).tgz" Condition="'$(_PdfiumActualSha256)' != '$(PdfiumSha256)'" />
    <Error Condition="'$(_PdfiumActualSha256)' != '$(PdfiumSha256)'"
           Text="PDFium $(PdfiumPackage) ($(PdfiumRelease)) has SHA-256 $(_PdfiumActualSha256), expected $(PdfiumSha256). The download was deleted and nothing was unpacked." />
    <Exec Command="tar -xzf &quot;$(PdfiumPackage).tgz&quot;" WorkingDirectory="$(PdfiumCache)" />
    <Error Condition="!Exists('$(PdfiumCache)$(PdfiumLibrary)')" Text="PDFium archive $(PdfiumPackage).tgz has no $(PdfiumLibrary)." />
  </Target>

</Project>
