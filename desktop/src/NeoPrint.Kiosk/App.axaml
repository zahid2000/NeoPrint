<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NeoPrint.Kiosk.App"
             RequestedThemeVariant="Dark">

    <!-- The kiosk is always dark: these screens sit in shopping centres and
         metro stations, often in low light. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
